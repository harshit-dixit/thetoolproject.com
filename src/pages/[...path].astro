---
import ToolLayout from '../layouts/Tool.astro';
import RichText from '../components/RichText.astro';
import HomePage from '../components/pages/HomePage.astro';
import AboutPage from '../components/pages/AboutPage.astro';
import ContactPage from '../components/pages/ContactPage.astro';
import PrivacyPage from '../components/pages/PrivacyPage.astro';
import TermsPage from '../components/pages/TermsPage.astro';
import NotFoundPage from '../components/pages/NotFoundPage.astro';
import TextToolFrame from '../components/TextToolFrame.astro';
import ExcelToCsvTool from '../components/ExcelToCsvTool.astro';
import DbfToExcelTool from '../components/DbfToExcelTool.astro';
import JsonToExcelTool from '../components/JsonToExcelTool.astro';
import JsonToCsvTool from '../components/JsonToCsvTool.astro';
import XmlToCsvTool from '../components/XmlToCsvTool.astro';
import XmlToJsonTool from '../components/XmlToJsonTool.astro';
import CsvToSqlTool from '../components/CsvToSqlTool.astro';
import JsonBeautifierTool from '../components/JsonBeautifierTool.astro';
import WordCounterTool from '../components/WordCounterTool.astro';
import TipCalculatorTool from '../components/TipCalculatorTool.astro';
import HighSchoolGpaTool from '../components/HighSchoolGpaTool.astro';
import CsvViewerTool from '../components/CsvViewerTool.astro';
import CsvToJsonTool from '../components/CsvToJsonTool.astro';
import QrCodeScannerTool from '../components/QrCodeScannerTool.astro';
import ImageTool from '../components/ImageTool.astro';
import CompressPdfTool from '../components/CompressPdfTool.astro';
import EmlToPdfTool from '../components/EmlToPdfTool.astro';
import WebpConverterTool from '../components/WebpConverterTool.astro';
import type { OutputFormat } from '../lib/webp-convert';
import { publishedToolLocales, getPublishedToolPath } from '../data/tools';
import { buildStaticPaths, type RouteProps } from '../data/routes';
import { t, formatNumber, langTag, type TranslationKey } from '../i18n/utils';
import { tipDefaults } from '../data/tip-defaults';
import { gradePoints, LETTERS, percentRange } from '../lib/high-school-gpa';

export function getStaticPaths() {
  const allowDrafts = import.meta.env.DEV && process.env.PREVIEW_DRAFTS === 'true';
  return buildStaticPaths({ allowDrafts });
}

type Props = RouteProps;

const props = Astro.props;
const locale = props.locale;
const isTool = props.kind === 'tool';
const tool = isTool ? props.tool : undefined;
const entry = isTool ? props.entry : undefined;
const alternates = isTool && tool ? Object.fromEntries(publishedToolLocales(tool).map(([lang, item]) => [lang, item.path])) : {};
const pdfTarget = isTool && tool ? ({ 'compress-pdf-to-100kb': 100, 'compress-pdf-to-200kb': 200, 'compress-pdf-to-500kb': 500 } as Record<string, 100 | 200 | 500>)[tool.id] : undefined;
// The WebP converter hub and its four format pages share one tool and one page frame.
const webpPages: Record<string, { prefix: 'webpConverter' | 'webpPng' | 'webpJpg' | 'webpGif' | 'webpSvg'; format?: OutputFormat }> = {
  'webp-converter': { prefix: 'webpConverter' },
  'webp-to-png': { prefix: 'webpPng', format: 'png' },
  'webp-to-jpg': { prefix: 'webpJpg', format: 'jpg' },
  'webp-to-gif': { prefix: 'webpGif', format: 'gif' },
  'webp-to-svg': { prefix: 'webpSvg', format: 'svg' },
};
const webp = isTool && tool ? webpPages[tool.id] : undefined;
const webpLinks = {
  hub: getPublishedToolPath('webpConverter', locale), png: getPublishedToolPath('webpToPng', locale), jpg: getPublishedToolPath('webpToJpg', locale),
  gif: getPublishedToolPath('webpToGif', locale), svg: getPublishedToolPath('webpToSvg', locale),
};
const webpButton = t('webp.convertButton', locale, { format: (webp?.format ?? 'png').toUpperCase() });
const webpFormatRows: [keyof typeof webpLinks, TranslationKey, TranslationKey, TranslationKey][] = [
  ['png', 'webpPng.h1', 'webpConverter.pngBest', 'webpConverter.pngKeeps'],
  ['jpg', 'webpJpg.h1', 'webpConverter.jpgBest', 'webpConverter.jpgKeeps'],
  ['gif', 'webpGif.h1', 'webpConverter.gifBest', 'webpConverter.gifKeeps'],
  ['svg', 'webpSvg.h1', 'webpConverter.svgBest', 'webpConverter.svgKeeps'],
];

// Usual tips by service, for the "How much to tip" table.
const tipGuideRows = ['restaurant', 'bar', 'takeout', 'delivery', 'grocery', 'coffee', 'hair', 'nails', 'tattoo', 'rideshare', 'movers', 'hotel'] as const;
const tipGuideKey = (row: (typeof tipGuideRows)[number], part: 'service' | 'tip' | 'note') => `tip.guide.${row}.${part}` as TranslationKey;
const tipFaqs = [1, 2, 3, 4, 5, 6] as const;
// The first answer names the tip the calculator starts at on this page.
const tipDefaultPercent = new Intl.NumberFormat(langTag(locale), { style: 'percent' }).format(tipDefaults[locale].tip / 100);
const tipSources = {
  emilyPost: 'https://emilypost.com/advice/general-tipping-guide',
  nerdwallet: 'https://www.nerdwallet.com/finance/learn/how-much-to-tip',
  rd: 'https://www.rd.com/article/how-much-to-tip/',
  usnews: 'https://money.usnews.com/money/personal-finance/spending/articles/how-much-should-you-tip-a-tattoo-artist',
  doordash: 'https://help.doordash.com/en-us/dashers/article/do-dashers-receive-tips',
  instacart: 'https://www.instacart.com/help/section/360007902791/360049068552',
};

// The GPA scale table: each letter's percent range and its points in regular, honors and AP/IB classes.
const hsGpaPoints = (value: number) => new Intl.NumberFormat(langTag(locale), { minimumFractionDigits: 1, maximumFractionDigits: 1 }).format(value);
const hsGpaScaleRows = LETTERS.map(letter => {
  const [min, max] = percentRange(letter);
  const cell = (level: 'regular' | 'honors' | 'ap') => letter === 'A+'
    ? t('hsGpa.scaleAPlus', locale, { low: hsGpaPoints(gradePoints('A+', level, 4).weighted), high: hsGpaPoints(gradePoints('A+', level, 4.3).weighted) })
    : hsGpaPoints(gradePoints(letter, level).weighted);
  return { letter, percent: letter === 'F' ? t('hsGpa.scaleBelow', locale, { min: formatNumber(60, locale) }) : `${formatNumber(min, locale)}–${formatNumber(max, locale)}`, regular: cell('regular'), honors: cell('honors'), ap: cell('ap') };
});
const hsGpaFaqs = [1, 2, 3, 4, 5, 6] as const;
const hsGpaSources = {
  bigfuture: 'https://bigfuture.collegeboard.org/plan-for-college/get-started/how-to-calculate-gpa-4.0-scale',
  hsts: 'https://www.nationsreportcard.gov/hstsreport/',
};

const excelRows: [TranslationKey, TranslationKey][] = [
  ['excel.howNumbers', 'excel.howNumbersResult'],
  ['excel.howDates', 'excel.howDatesResult'],
  ['excel.howFormulas', 'excel.howFormulasResult'],
  ['excel.howMerged', 'excel.howMergedResult'],
  ['excel.howHidden', 'excel.howHiddenResult'],
  ['excel.howFormatting', 'excel.howFormattingResult'],
];
const jsonExcelRows: [TranslationKey, TranslationKey][] = [
  ['jsonExcel.howArray', 'jsonExcel.howArrayResult'],
  ['jsonExcel.howObject', 'jsonExcel.howObjectResult'],
  ['jsonExcel.howList', 'jsonExcel.howListResult'],
  ['jsonExcel.howSimpleList', 'jsonExcel.howSimpleListResult'],
  ['jsonExcel.howRoot', 'jsonExcel.howRootResult'],
  ['jsonExcel.howGrid', 'jsonExcel.howGridResult'],
];
---
{props.kind === 'page' && (
  <>
    {props.page.id === 'home' && <HomePage locale={locale} />}
    {props.page.id === 'about' && <AboutPage locale={locale} />}
    {props.page.id === 'contact' && <ContactPage locale={locale} />}
    {props.page.id === 'privacy' && <PrivacyPage locale={locale} />}
    {props.page.id === 'terms' && <TermsPage locale={locale} />}
    {props.page.id === 'notFound' && <NotFoundPage locale={locale} />}
  </>
)}
{isTool && tool && entry && (
  <ToolLayout locale={locale} entry={entry} toolId={tool.id} category={tool.category} alternates={alternates}>
    <main class="wrap">
      {tool.id === 'compress-pdf' && <>
        <div class="hero"><h1 class="page-title">{entry.h1}</h1><div class="hero-row"><p class="lead"><strong>{t('compressPdf.leadStrong', locale)}</strong> {t('compressPdf.lead', locale)}</p><p class="caption">{t('compressPdf.caption', locale)}</p></div></div>
        <CompressPdfTool locale={locale} />
        <section aria-labelledby="pdf-how-title"><div class="sec-head"><h2 id="pdf-how-title">{t('compressPdf.howTitle', locale)}</h2></div><div class="how-copy">
          <p><RichText text={t('compressPdf.howIntro', locale, { button: t('pdf.compressButton', locale) })} /></p>
          <h3>{t('compressPdf.howKeepTitle', locale)}</h3>
          <p><RichText text={t('compressPdf.howKeepP1', locale, { keepText: t('pdf.keepText', locale), makeSmaller: t('pdf.makeSmaller', locale) })} /></p>
          <p>{t('compressPdf.howKeepP2', locale)}</p>
          <h3>{t('compressPdf.howLimitTitle', locale)}</h3>
          <p><RichText
            text={t('compressPdf.howLimitP', locale)}
            links={{
              pdf100: getPublishedToolPath('compressPdf100kb', locale),
              pdf200: getPublishedToolPath('compressPdf200kb', locale),
              pdf500: getPublishedToolPath('compressPdf500kb', locale)
            }}
            params={{
              pdf100Label: t('unit.kbTarget', locale, { n: 100 }),
              pdf200Label: t('unit.kbTarget', locale, { n: 200 }),
              pdf500Label: t('unit.kbTarget', locale, { n: 500 })
            }}
          /></p>
          <h3>{t('compressPdf.faqTitle', locale)}</h3>
          <p><strong>{t('compressPdf.faqQ1', locale)}</strong> {t('compressPdf.faqA1', locale)}</p>
          <p><strong>{t('compressPdf.faqQ2', locale)}</strong> {t('compressPdf.faqA2', locale)}</p>
          <p><strong>{t('compressPdf.faqQ3', locale)}</strong> {t('compressPdf.faqA3', locale)}</p>
        </div></section>
      </>}
      {pdfTarget && <>
        <div class="hero"><h1 class="page-title">{entry.h1}</h1><div class="hero-row"><p class="lead"><strong>{t('compressPdf.target.leadStrong', locale, { target: pdfTarget })}</strong> {t('compressPdf.target.lead', locale)}</p><p class="caption">{t('compressPdf.target.caption', locale, { target: pdfTarget, bytes: pdfTarget * 1024 })}</p></div></div>
        <CompressPdfTool locale={locale} targetKb={pdfTarget} />
        <section aria-labelledby="pdf-target-how-title"><div class="sec-head"><h2 id="pdf-target-how-title">{t('compressPdf.target.howTitle', locale, { target: pdfTarget })}</h2></div><div class="how-copy">
          <p><RichText text={t('compressPdf.target.howP1', locale, { target: pdfTarget, button: t('pdf.compressButton', locale) })} /></p>
          <p><RichText text={t('compressPdf.target.howP2', locale, { keepText: t('pdf.keepText', locale) })} /></p>
          <p>{t('compressPdf.target.howP3', locale, { target: pdfTarget })}</p>
          {pdfTarget === 100 && <p><RichText text={t('compressPdf.target.how100', locale)} /></p>}
          {pdfTarget === 200 && <p><RichText text={t('compressPdf.target.how200', locale)} /></p>}
          {pdfTarget === 500 && <p><RichText text={t('compressPdf.target.how500', locale)} /></p>}
          <p><RichText
            text={t('compressPdf.target.howOther', locale)}
            links={{
              target1: pdfTarget === 100 ? getPublishedToolPath('compressPdf200kb', locale) : getPublishedToolPath('compressPdf100kb', locale),
              target2: pdfTarget === 500 ? getPublishedToolPath('compressPdf200kb', locale) : getPublishedToolPath('compressPdf500kb', locale),
              main: getPublishedToolPath('compressPdf', locale)
            }}
            params={{
              target1Label: t('unit.kbTarget', locale, { n: pdfTarget === 100 ? 200 : 100 }),
              target2Label: t('unit.kbTarget', locale, { n: pdfTarget === 500 ? 200 : 500 }),
              mainLabel: t('compressPdf.target.generalLinkText', locale)
            }}
          /></p>
        </div></section>
      </>}
      {tool.id === 'image-resizer' && <>
        <div class="hero"><h1 class="page-title">{entry.h1}</h1><div class="hero-row"><p class="lead"><strong>{t('imageResizer.leadStrong', locale)}</strong> {t('imageResizer.lead', locale)}</p><p class="caption">{t('imageResizer.caption', locale)}</p></div></div>
        <ImageTool locale={locale} mode="resize" />
        <section aria-labelledby="image-how-title"><div class="sec-head"><h2 id="image-how-title">{t('imageResizer.howTitle', locale)}</h2><p>{t('imageResizer.howSubtitle', locale)}</p></div><div class="how-copy">
          <p>{t('imageResizer.howIntro', locale)}</p>
          <h3>{t('imageResizer.howBatchTitle', locale)}</h3>
          <p><RichText text={t('imageResizer.howBatchP', locale, { lockAspect: t('image.lockAspect', locale), noEnlarge: t('image.noEnlarge', locale), estimate: t('image.estimateButton', locale) })} /></p>
          <h3>{t('imageResizer.howCmTitle', locale)}</h3>
          <p><RichText text={t('imageResizer.howCmP', locale, { cmMode: t('image.modeCm', locale) })} /></p>
          <h3>{t('imageResizer.howKbTitle', locale)}</h3>
          <p><RichText
            text={t('imageResizer.howKbP', locale, { kbMode: t('image.modeKb', locale), jpg50Label: t('compressJpg50kb.h1', locale), jpg100Label: t('compressJpg100kb.h1', locale) })}
            links={{
              jpg100: getPublishedToolPath('compressJpg100kb', locale),
              jpg50: getPublishedToolPath('compressJpg50kb', locale)
            }}
          /></p>
          <h3>{t('imageResizer.howFormatsTitle', locale)}</h3>
          <p>{t('imageResizer.howFormatsP', locale)}</p>
        </div></section>
      </>}
      {webp && <>
        <div class="hero"><h1 class="page-title">{entry.h1}</h1><div class="hero-row"><p class="lead"><strong>{t(`${webp.prefix}.leadStrong`, locale)}</strong> {t(`${webp.prefix}.lead`, locale)}</p><p class="caption">{t(`${webp.prefix}.caption`, locale)}</p></div></div>
        <WebpConverterTool locale={locale} format={webp.format} />
        <section aria-labelledby="webp-how-title"><div class="sec-head"><h2 id="webp-how-title">{t(`${webp.prefix}.howTitle`, locale)}</h2></div><div class="how-copy">
          {webp.prefix === 'webpConverter' && <>
            <p><RichText text={t('webpConverter.howIntro', locale, { formatLabel: t('webp.formatLabel', locale), button: webpButton })} /></p>
            <h3>{t('webpConverter.howChooseTitle', locale)}</h3>
            <div class="table-scroll"><table class="spec-table"><thead><tr><th scope="col">{t('webpConverter.tableFormat', locale)}</th><th scope="col">{t('webpConverter.tableBestFor', locale)}</th><th scope="col">{t('webpConverter.tableKeeps', locale)}</th></tr></thead><tbody>
              {webpFormatRows.map(([format, name, best, keeps]) => <tr><td><a href={webpLinks[format]}>{t(name, locale)}</a></td><td class="note">{t(best, locale)}</td><td class="note">{t(keeps, locale)}</td></tr>)}
            </tbody></table></div>
            <h3>{t('webpConverter.howBulkTitle', locale)}</h3>
            <p><RichText text={t('webpConverter.howBulkP', locale)} /></p>
            <h3>{t('webpConverter.howLimitsTitle', locale)}</h3>
            <p>{t('webpConverter.howLimitsP', locale)}</p>
          </>}
          {webp.prefix === 'webpPng' && <>
            <p><RichText text={t('webpPng.howIntro', locale, { button: webpButton })} /></p>
            <h3>{t('webpPng.howQualityTitle', locale)}</h3>
            <p><RichText text={t('webpPng.howQualityP', locale)} links={webpLinks} /></p>
            <h3>{t('webpPng.howAnimatedTitle', locale)}</h3>
            <p><RichText text={t('webpPng.howAnimatedP', locale)} links={webpLinks} /></p>
          </>}
          {webp.prefix === 'webpJpg' && <>
            <p><RichText text={t('webpJpg.howIntro', locale, { button: webpButton })} /></p>
            <h3>{t('webpJpg.howQualityTitle', locale)}</h3>
            <p><RichText text={t('webpJpg.howQualityP', locale, { max: t('webp.qualityMax', locale), high: t('webp.qualityHigh', locale), small: t('webp.qualitySmall', locale) })} /></p>
            <h3>{t('webpJpg.howTransparencyTitle', locale)}</h3>
            <p><RichText text={t('webpJpg.howTransparencyP', locale)} links={webpLinks} /></p>
            <h3>{t('webpJpg.howJpegTitle', locale)}</h3>
            <p><RichText text={t('webpJpg.howJpegP', locale)} links={webpLinks} /></p>
          </>}
          {webp.prefix === 'webpGif' && <>
            <p><RichText text={t('webpGif.howIntro', locale, { button: webpButton })} /></p>
            <h3>{t('webpGif.howColorsTitle', locale)}</h3>
            <p><RichText text={t('webpGif.howColorsP', locale)} links={webpLinks} /></p>
            <h3>{t('webpGif.howBrowserTitle', locale)}</h3>
            <p><RichText text={t('webpGif.howBrowserP', locale)} links={webpLinks} /></p>
          </>}
          {webp.prefix === 'webpSvg' && <>
            <p><RichText text={t('webpSvg.howIntro', locale, { button: webpButton })} /></p>
            <h3>{t('webpSvg.howTypesTitle', locale)}</h3>
            <p><RichText text={t('webpSvg.howTraceP', locale, { trace: t('webp.svgTrace', locale) })} /></p>
            <p><RichText text={t('webpSvg.howEmbedP', locale, { embed: t('webp.svgEmbed', locale) })} /></p>
            <h3>{t('webpSvg.howColorsTitle', locale)}</h3>
            <p>{t('webpSvg.howColorsP', locale)}</p>
          </>}
          <h3>{t('webp.faqTitle', locale)}</h3>
          <p><strong>{t(`${webp.prefix}.faqQ1`, locale)}</strong> <RichText text={t(`${webp.prefix}.faqA1`, locale)} links={webpLinks} params={{ trace: t('webp.svgTrace', locale), embed: t('webp.svgEmbed', locale) }} /></p>
          <p><strong>{t(`${webp.prefix}.faqQ2`, locale)}</strong> <RichText text={t(`${webp.prefix}.faqA2`, locale)} links={webpLinks} /></p>
          <p><strong>{t('webp.faqUploadQ', locale)}</strong> {t('webp.faqUploadA', locale)}</p>
        </div></section>
      </>}
      {tool.id === 'compress-jpg-to-100kb' && <>
        <div class="hero"><h1 class="page-title">{entry.h1}</h1><div class="hero-row"><p class="lead"><strong>{t('compressJpg.leadStrong', locale, { target: 100 })}</strong> {t('compressJpg.lead', locale, { target: 100 })}</p><p class="caption">{t('compressJpg.caption', locale)}</p></div></div>
        <ImageTool locale={locale} mode="compress" targetKb={100} />
        <section aria-labelledby="jpg-how-title"><div class="sec-head"><h2 id="jpg-how-title">{t('compressJpg.howTitle', locale, { target: 100 })}</h2></div><div class="how-copy">
          <p>{t('compressJpg.howP1', locale, { target: 100, bytes: formatNumber(102400, locale), fileSizeText: t('compressJpg.fileSizePlain', locale) })}</p>
          <p>{t('compressJpg.howP2', locale, { target: 100 })}</p>
          <p><RichText
            text={t('compressJpg.how100Other', locale)}
            links={{ resizer: getPublishedToolPath('imageResizer', locale) }}
          /></p>
        </div></section>
      </>}
      {tool.id === 'compress-jpg-to-50kb' && <>
        <div class="hero"><h1 class="page-title">{entry.h1}</h1><div class="hero-row"><p class="lead"><strong>{t('compressJpg.leadStrong', locale, { target: 50 })}</strong> {t('compressJpg.lead', locale, { target: 50 })}</p><p class="caption">{t('compressJpg.caption', locale)}</p></div></div>
        <ImageTool locale={locale} mode="compress" targetKb={50} />
        <section aria-labelledby="jpg-50-how-title"><div class="sec-head"><h2 id="jpg-50-how-title">{t('compressJpg.howTitle', locale, { target: 50 })}</h2></div><div class="how-copy">
          <p>{t('compressJpg.howP1', locale, { target: 50, bytes: formatNumber(51200, locale), fileSizeText: t('compressJpg.fileSizeExact', locale) })}</p>
          <p>{t('compressJpg.howP2', locale, { target: 50 })}</p>
          <p><RichText
            text={t('compressJpg.how50Other', locale)}
            links={{
              jpg100: getPublishedToolPath('compressJpg100kb', locale),
              resizer: getPublishedToolPath('imageResizer', locale)
            }}
            params={{ jpg100Label: t('compressJpg100kb.h1', locale) }}
          /></p>
        </div></section>
      </>}
      {tool.id === 'qr-code-scanner' && <>
        <div class="hero"><h1 class="page-title">{entry.h1}</h1><div class="hero-row"><p class="lead"><strong>{t('qrScanner.leadStrong', locale)}</strong> {t('qrScanner.lead', locale)}</p><p class="caption">{t('qrScanner.caption', locale)}</p></div></div>
        <QrCodeScannerTool locale={locale} />
        <section aria-labelledby="qr-how-title"><div class="sec-head"><h2 id="qr-how-title">{t('qrScanner.howTitle', locale)}</h2><p>{t('qrScanner.howSubtitle', locale)}</p></div><div class="how-copy">
          <h3>{t('qrScanner.howCameraTitle', locale)}</h3>
          <p>{t('qrScanner.howCameraP', locale)}</p>
          <h3>{t('qrScanner.howImageTitle', locale)}</h3>
          <p><RichText text={t('qrScanner.howImageP', locale)} /></p>
          <h3>{t('qrScanner.howResultTitle', locale)}</h3>
          <p><RichText text={t('qrScanner.howResultP1', locale)} /></p>
          <p>{t('qrScanner.howResultP2', locale)}</p>
          <h3>{t('qrScanner.faqTitle', locale)}</h3>
          <p><strong>{t('qrScanner.faqQ1', locale)}</strong> {t('qrScanner.faqA1', locale)}</p>
          <p><strong>{t('qrScanner.faqQ2', locale)}</strong> {t('qrScanner.faqA2', locale)}</p>
          <p><strong>{t('qrScanner.faqQ3', locale)}</strong> {t('qrScanner.faqA3', locale)}</p>
        </div></section>
      </>}
      {tool.id === 'csv-to-json' && <>
        <div class="hero"><h1 class="page-title">{entry.h1}</h1><div class="hero-row"><p class="lead"><strong>{t('csvJson.leadStrong', locale)}</strong> {t('csvJson.lead', locale)}</p><p class="caption">{t('csvJson.caption', locale)}</p></div></div>
        <CsvToJsonTool locale={locale} />
        <section aria-labelledby="how-title"><div class="sec-head"><h2 id="how-title">{t('csvJson.howTitle', locale)}</h2></div><div class="how-copy">
          <p>{t('csvJson.howIntro', locale)}</p>
          <h3>{t('csvJson.howMapTitle', locale)}</h3>
          <div class="table-scroll"><table class="spec-table mapping-table"><thead><tr><th scope="col">{t('csvJson.howInput', locale)}</th><th scope="col">{t('csvJson.howResult', locale)}</th></tr></thead><tbody>
            <tr><td>{t('csvJson.howFirstRow', locale)}</td><td>{t('csvJson.howFirstRowResult', locale)}</td></tr>
            <tr><td>{t('csvJson.howNoHeader', locale)}</td><td><RichText text={t('csvJson.howNoHeaderResult', locale, { col1: 'Column 1', col2: 'Column 2' })} /></td></tr>
            <tr><td><RichText text={t('csvJson.howValues', locale)} /></td><td><RichText text={t('csvJson.howValuesResult', locale)} /></td></tr>
            <tr><td>{t('csvJson.howQuotes', locale)}</td><td>{t('csvJson.howQuotesResult', locale)}</td></tr>
          </tbody></table></div>
          <p>{t('csvJson.howSeparators', locale)}</p>
          <p><RichText text={t('csvJson.howOutput', locale)} /></p>
          <p><RichText
            text={t('csvJson.howLimits', locale)}
            links={{
              csvViewer: getPublishedToolPath('csvViewer', locale),
              jsonCsv: getPublishedToolPath('jsonToCsv', locale)
            }}
            params={{ jsonCsvLabel: t('jsonCsv.h1', locale) }}
          /></p>
        </div></section>
      </>}
      {tool.id === 'csv-viewer' && <>
