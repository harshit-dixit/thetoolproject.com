---
import Tool from '../layouts/Tool.astro';
import TextToolFrame from '../components/TextToolFrame.astro';
import ExcelToCsvTool from '../components/ExcelToCsvTool.astro';
import JsonToExcelTool from '../components/JsonToExcelTool.astro';
import JsonToCsvTool from '../components/JsonToCsvTool.astro';
import XmlToCsvTool from '../components/XmlToCsvTool.astro';
import XmlToJsonTool from '../components/XmlToJsonTool.astro';
import CsvToSqlTool from '../components/CsvToSqlTool.astro';
import JsonBeautifierTool from '../components/JsonBeautifierTool.astro';
import CsvViewerTool from '../components/CsvViewerTool.astro';
import CsvToJsonTool from '../components/CsvToJsonTool.astro';
import QrCodeScannerTool from '../components/QrCodeScannerTool.astro';
import ImageTool from '../components/ImageTool.astro';
import CompressPdfTool from '../components/CompressPdfTool.astro';
import { tools, publishedToolLocales } from '../data/tools';
import { t, type TranslationKey } from '../i18n/utils';
export function getStaticPaths() {
  return Object.values(tools).flatMap(tool => publishedToolLocales(tool).map(([locale, entry]) => ({ params: { tool: entry.path.replace(/^\/|\/$/g, '') }, props: { locale, entry, tool } })));
}
const { locale, entry, tool } = Astro.props;
const pdfTarget = ({ 'compress-pdf-to-100kb': 100, 'compress-pdf-to-200kb': 200, 'compress-pdf-to-500kb': 500 } as Record<string, 100 | 200 | 500>)[tool.id];
const alternates = Object.fromEntries(publishedToolLocales(tool).map(([lang, item]) => [lang, item.path]));
const excelRows: [TranslationKey, TranslationKey][] = [
  ['excel.howNumbers', 'excel.howNumbersResult'],
  ['excel.howDates', 'excel.howDatesResult'],
  ['excel.howFormulas', 'excel.howFormulasResult'],
  ['excel.howMerged', 'excel.howMergedResult'],
  ['excel.howHidden', 'excel.howHiddenResult'],
  ['excel.howFormatting', 'excel.howFormattingResult'],
];
const jsonExcelRows: [TranslationKey, TranslationKey][] = [
  ['jsonExcel.howArray', 'jsonExcel.howArrayResult'],
  ['jsonExcel.howObject', 'jsonExcel.howObjectResult'],
  ['jsonExcel.howList', 'jsonExcel.howListResult'],
  ['jsonExcel.howSimpleList', 'jsonExcel.howSimpleListResult'],
  ['jsonExcel.howRoot', 'jsonExcel.howRootResult'],
  ['jsonExcel.howGrid', 'jsonExcel.howGridResult'],
];
---
<Tool {locale} {entry} category={tool.category} {alternates}>
  <main class="wrap">
    {tool.id === 'compress-pdf' && <>
      <div class="hero"><h1 class="page-title">{entry.h1}</h1><div class="hero-row"><p class="lead"><strong>Make a PDF easier to share.</strong> Choose a compression level, compare file sizes, and download the result. Your PDF stays in this browser.</p><p class="caption">Free PDF compressor · No upload · No sign-up</p></div></div>
      <CompressPdfTool />
      <section aria-labelledby="pdf-how-title"><div class="sec-head"><h2 id="pdf-how-title">How PDF compression works here</h2></div><div class="how-copy">
        <p>Choose or drop one PDF, select how to compress it, and click <strong>Compress PDF</strong>. You will see the original size, output size and percentage saved before download. Files up to 30MB and 60 pages are supported. Processing happens in your browser.</p>
        <h3>Keep text or make a smaller file</h3>
        <p><strong>Keep text and links</strong> rewrites the PDF structure. It preserves selectable text, links and forms, but often saves little space. <strong>Make it smaller</strong> renders each page as a JPEG image in a new PDF. This can reduce image-heavy and scanned PDFs substantially, but text can no longer be selected or searched, and links, forms, bookmarks and accessibility information are lost. Check the result before sharing it.</p>
        <p>Do not use either rewrite mode for a digitally signed PDF you need to keep valid. Any change to a signed file can invalidate its signature.</p>
        <h3>Choose a size limit</h3>
        <p>Use the maximum-size selector when a website asks for a file under 100KB, 200KB or 500KB. If needed, the tool tries progressively smaller image settings. A target cannot be guaranteed: page count and image detail set a practical minimum. The measured output and a clear target status are always shown. For a preselected limit, use <a href="/compress-pdf-to-100kb/">100KB</a>, <a href="/compress-pdf-to-200kb/">200KB</a> or <a href="/compress-pdf-to-500kb/">500KB</a>.</p>
        <h3>Frequently asked questions</h3>
        <p><strong>Will my PDF be uploaded?</strong> No. It is read and processed on your device.</p>
        <p><strong>Why did the file not get smaller?</strong> A PDF may already contain efficient images and compressed streams. This tool keeps the original if its alternatives would be larger.</p>
        <p><strong>Can I compress a password-protected PDF?</strong> No. Unlock it first in an app you trust, then choose the unlocked file.</p>
      </div></section>
    </>}
    {pdfTarget && <>
      <div class="hero"><h1 class="page-title">{entry.h1}</h1><div class="hero-row"><p class="lead"><strong>Check whether your PDF can fit a {pdfTarget}KB limit.</strong> Compress it in your browser, see the exact output size, and download it when it meets your needs.</p><p class="caption">{pdfTarget}KB = {pdfTarget * 1024} bytes · No upload</p></div></div>
      <CompressPdfTool targetKb={pdfTarget} />
      <section aria-labelledby="pdf-target-how-title"><div class="sec-head"><h2 id="pdf-target-how-title">How to compress a PDF to {pdfTarget}KB</h2></div><div class="how-copy">
        <p>Choose a PDF or drag it into the tool. The maximum size is already set to {pdfTarget}KB. Click <strong>Compress PDF</strong> and compare the measured result with the limit before downloading. If your PDF is already at or under {pdfTarget}KB, the original is kept.</p>
        <p>For a tight limit, the default mode rebuilds pages as compressed images. This removes selectable text, live links, forms, bookmarks and accessibility information. Switch to <strong>Keep text and links</strong> if those features matter; that mode usually achieves a smaller reduction. Image-heavy scans tend to shrink more than text-only PDFs.</p>
        <p>Not every PDF can reach {pdfTarget}KB. More pages and detailed graphics need more data, and aggressive compression may make small text hard to read. The tool reports when it cannot reach the limit and never labels an oversized result as successful. Check legibility before submitting the file.</p>
        {pdfTarget === 100 && <p><strong>For a 100KB form limit:</strong> a one-page PDF has a better chance than a long document. If the result is over 100KB or fine print becomes unreadable, reduce the source scan resolution or remove unneeded pages in your PDF editor before trying again.</p>}
        {pdfTarget === 200 && <p><strong>For a 200KB application upload:</strong> start with Balanced compression, then inspect names, dates and any small printed labels in the download. Choose Strong if size matters more than fine image detail.</p>}
        {pdfTarget === 500 && <p><strong>For a 500KB attachment:</strong> try Light compression to retain more visual detail. If your PDF already fits, this tool returns it unchanged. If selectable text matters, try Keep text and links and check whether that result fits.</p>}
        <p>Need another limit? Try <a href="/compress-pdf-to-100kb/">100KB</a>, <a href="/compress-pdf-to-200kb/">200KB</a>, <a href="/compress-pdf-to-500kb/">500KB</a>, or use the <a href="/compress-pdf/">general PDF compressor</a>. Files stay on your device.</p>
      </div></section>
    </>}
    {tool.id === 'image-resizer' && <>
      <div class="hero"><h1 class="page-title">{entry.h1}</h1><div class="hero-row"><p class="lead"><strong>Resize a photo to the size you need.</strong> Set pixels, a percentage, centimetres or a maximum KB. Apply the same settings to a batch and download each result or one ZIP.</p><p class="caption">Free online photo resizer · Up to 20 images · No upload</p></div></div>
      <ImageTool mode="resize" />
      <section aria-labelledby="image-how-title"><div class="sec-head"><h2 id="image-how-title">How to resize an image online</h2><p>Choose your images, set a size and download the results.</p></div><div class="how-copy">
        <p>Choose JPG, PNG or WebP images, or drop them on the tool. This online image resizer handles up to 20 photos at once. Each file can be up to 25MB. Processing happens in your browser, so your images are not uploaded.</p>
        <h3>Pixels, percentage and bulk image resizing</h3>
        <p>Enter a width and height in pixels, or scale each image by a percentage. With <strong>Keep aspect ratio</strong> on, the dimensions form a maximum-size box: each image fits inside it without being stretched. Turn it off to set exact width and height. <strong>Do not enlarge small images</strong> prevents a smaller photo from being scaled up. Select <strong>Estimate output size</strong> to check the first image before resizing; in a batch, each image may produce a different file size. For a batch, the same settings are applied to every image; choose individual downloads or a ZIP.</p>
        <h3>Resize an image in cm</h3>
        <p>Choose <strong>Centimetres</strong> and enter the intended width, height and resolution in pixels per inch (PPI). The tool converts cm to pixel dimensions using <code>pixels = cm ÷ 2.54 × PPI</code>. For example, 5 cm at 300 PPI is about 591 pixels. The downloaded image does not have a print-size or DPI metadata setting, so set the same print resolution in your printing software.</p>
        <h3>Resize an image in KB</h3>
        <p>Choose <strong>File size (KB)</strong> and enter a maximum. This mode saves a JPG, adjusts its quality and, if needed, reduces its pixel dimensions until it fits. Transparent areas become white. Some detail may be lost at a small target size. A JPG already under the limit is kept as-is. Need a specific JPG limit? Use <a href="/compress-jpg-to-50kb/">Compress JPG to 50KB</a> or <a href="/compress-jpg-to-100kb/">Compress JPG to 100KB</a>.</p>
        <h3>File formats and quality</h3>
        <p>For pixel, percentage and cm resizing, save in the original format or choose JPG, PNG or WebP. JPG cannot keep transparency; transparent pixels are filled white. PNG can be larger than the original even when its dimensions shrink. Animated images and SVG are not supported. Resizing upward creates more pixels but cannot recover detail that was not in the original.</p>
      </div></section>
    </>}
    {tool.id === 'compress-jpg-to-100kb' && <>
      <div class="hero"><h1 class="page-title">{entry.h1}</h1><div class="hero-row"><p class="lead"><strong>Make a JPG fit a 100KB limit.</strong> Choose a photo, preview it, then download a JPG at or below 100KB. The exact output size is shown before you save.</p><p class="caption">Free JPG compressor · No upload · No sign-up</p></div></div>
      <ImageTool mode="compress" targetKb={100} />
      <section aria-labelledby="jpg-how-title"><div class="sec-head"><h2 id="jpg-how-title">How the 100KB compressor works</h2></div><div class="how-copy">
        <p>Choose one JPG or drop it on the tool. It searches for a high JPG quality that fits within 100KB (102,400 bytes). If reducing quality is not enough, it reduces the image dimensions and tries again. The result shows its pixel dimensions and file size before download.</p>
        <p>If the original JPG is already 100KB or less, you can download an unchanged copy. Compression may remove fine detail, especially in photos with text or complex patterns. A very small limit may require a noticeably smaller image. Everything runs in your browser; the photo is not sent to a server.</p>
        <p>Need a different KB target or want to resize by pixels or centimetres? Open the <a href="/image-resizer/">image resizer</a>.</p>
      </div></section>
    </>}
    {tool.id === 'compress-jpg-to-50kb' && <>
      <div class="hero"><h1 class="page-title">{entry.h1}</h1><div class="hero-row"><p class="lead"><strong>Make a JPG fit a 50KB limit.</strong> Choose a photo, preview it, then download a JPG at or below 50KB. The exact output size is shown before you save.</p><p class="caption">Free JPG compressor · No upload · No sign-up</p></div></div>
      <ImageTool mode="compress" targetKb={50} />
      <section aria-labelledby="jpg-50-how-title"><div class="sec-head"><h2 id="jpg-50-how-title">How the 50KB compressor works</h2></div><div class="how-copy">
        <p>Choose one JPG or drop it on the tool. It searches for a high JPG quality that fits within 50KB (51,200 bytes). If reducing quality is not enough, it reduces the image dimensions and tries again. The result shows its pixel dimensions and exact file size before download.</p>
        <p>If the original JPG is already 50KB or less, you can download an unchanged copy. Compression may remove fine detail, especially in photos with text or complex patterns. A 50KB limit may require a noticeably smaller image. Everything runs in your browser; the photo is not sent to a server.</p>
        <p>Need a larger limit? Try <a href="/compress-jpg-to-100kb/">Compress JPG to 100KB</a>. For a different KB target or resizing by pixels or centimetres, use the <a href="/image-resizer/">image resizer</a>.</p>
      </div></section>
    </>}
    {tool.id === 'qr-code-scanner' && <>
      <div class="hero"><h1 class="page-title">{entry.h1}</h1><div class="hero-row"><p class="lead"><strong>Scan a QR code right here.</strong> Use your camera, choose an image, or paste a screenshot. Review the decoded link or text before you act on it.</p><p class="caption">Free online QR scanner · No sign-up · On-device decoding</p></div></div>
      <QrCodeScannerTool />
      <section aria-labelledby="qr-how-title"><div class="sec-head"><h2 id="qr-how-title">How to scan a QR code</h2><p>Your camera feed and images stay on your device.</p></div><div class="how-copy">
        <h3>With your camera</h3>
        <p>The camera starts when you open this page. Allow camera access when prompted, then keep the full code in view until it is read. The camera stops after a successful scan. You can inspect and copy the full result, then choose whether to open a web link.</p>
        <h3>From an image or screenshot</h3>
        <p>Choose <strong>Image</strong>, then select or drop a PNG, JPG, WebP, GIF or BMP image. You can also paste a screenshot from your clipboard. For best results, use a clear, straight-on image with the entire QR code and its blank border visible.</p>
        <h3>What happens to the result?</h3>
        <p>The scanner shows the exact text encoded in the QR code. For web links, it also shows the destination and offers an explicit Open link button. It never opens a scanned link automatically. Only <code>http://</code> and <code>https://</code> addresses can be opened from the result. Scans are not saved or uploaded.</p>
        <p>This online QR code scanner works in modern desktop and mobile browsers. Camera access needs a secure connection and your permission. If camera access is unavailable, scan a saved image instead. It reads QR codes, rather than other barcode types.</p>
        <h3>Frequently asked questions</h3>
        <p><strong>Is the QR scanner free?</strong> Yes. There is no account, installation, or scan limit.</p>
        <p><strong>Can I scan a QR code from a screenshot?</strong> Yes. Choose an image or paste a screenshot into the image panel.</p>
        <p><strong>Is my camera recording?</strong> No. Decoding happens in this browser tab. Camera access stops when you stop scanning, scan a code, switch to image mode, or leave the page.</p>
      </div></section>
    </>}
    {tool.id === 'csv-to-json' && <>
      <div class="hero"><h1 class="page-title">{entry.h1}</h1><div class="hero-row"><p class="lead"><strong>Paste CSV. See JSON immediately.</strong> Check the parsed rows, choose how values are handled, then copy or download the complete result. Your data stays in your browser.</p><p class="caption">CSV, TSV and text files up to 10 MB</p></div></div>
      <CsvToJsonTool />
      <section aria-labelledby="how-title"><div class="sec-head"><h2 id="how-title">How CSV becomes JSON</h2></div><div class="how-copy">
        <p>Paste CSV or TSV, choose a local file, or drag one into the converter. It reads the file on your device and converts it in a browser worker. Nothing is uploaded. The output updates as you edit the input or settings.</p>
        <h3>Choose how to map rows</h3>
        <div class="table-scroll"><table class="spec-table mapping-table"><thead><tr><th scope="col">CSV input</th><th scope="col">JSON result</th></tr></thead><tbody>
          <tr><td>First row contains names</td><td>Each following row becomes an object with those names as keys. Blank or repeated names get unique labels.</td></tr>
          <tr><td>No header row</td><td>Every row becomes an object with keys such as <code>Column 1</code> and <code>Column 2</code>.</td></tr>
          <tr><td><code>001</code>, <code>true</code>, empty cell</td><td>Values stay strings by default, preserving codes and leading zeros. You can detect safe numbers and booleans or turn empty cells into <code>null</code>.</td></tr>
          <tr><td>A quoted comma, quote or line break</td><td>It stays within one field. Double a quote inside a quoted field, as standard CSV requires.</td></tr>
        </tbody></table></div>
        <p>Auto detect checks comma, semicolon, tab and pipe separators. You can set one explicitly if the preview looks wrong. UTF-8, UTF-16 and Windows-1252 files are supported; set the encoding if characters look incorrect.</p>
        <p>Pretty and compact output are JSON arrays. JSON Lines writes one object per line for tools that accept <code>.jsonl</code>. The preview shows at most eight rows and 25 columns; Copy JSON and Download include all rows and columns. Rows with fewer fields get empty values, and rows with extra fields get generated column names. The converter points out differing row widths and renamed headers.</p>
        <p>Files are limited to 10 MB and 500 columns. Large conversions may use substantial memory on a phone. Need to explore or edit the table first? Open the <a href="/csv-viewer/">CSV viewer</a>. For the reverse conversion, use <a href="/json-to-csv/">JSON to CSV</a>.</p>
      </div></section>
    </>}
    {tool.id === 'csv-viewer' && <>
      <div class="hero"><h1 class="page-title">{entry.h1}</h1><div class="hero-row"><p class="lead"><strong>Open and explore a CSV in seconds.</strong> Search rows, filter a column, sort, fix cells and export the result. Everything runs locally in your browser.</p><p class="caption">.csv, .tsv, .tab and .txt files up to 10 MB</p></div></div>
      <CsvViewerTool />
      <section aria-labelledby="how-title"><div class="sec-head"><h2 id="how-title">How the viewer works</h2></div><div class="how-copy">
        <p>Choose a file, drop it on the viewer, or paste CSV text. The file is read and parsed in a browser worker; its contents are not sent to a server. Commas, semicolons, tabs and pipes are detected automatically. If the table looks wrong, set the separator in Import settings before opening the file.</p>
        <h3>Explore and edit</h3>
        <p>Search every column, filter one column by text, and click a heading to sort in either direction. The column details panel counts shown values, blanks and distinct values, with examples. Click a cell to change it. Revert edits restores the original values in this tab.</p>
        <p>The grid renders only rows near the visible area so large tables remain practical to scroll. Files are limited to 10 MB and 500 columns; very large datasets can still use substantial device memory. Rows with missing fields are padded with empty cells, and you can isolate rows whose field counts differ.</p>
        <h3>Save what you need</h3>
        <p>Choose all rows or shown rows before downloading CSV or JSON, or copying tab-separated text. CSV downloads use commas and UTF-8. JSON values remain strings, so codes such as <code>001</code> are preserved. Your original file is never changed.</p>
        <p>UTF-8, UTF-16 and Windows-1252 file encodings are supported. Encoding detection uses byte marks and text checks; choose the encoding manually in Import settings if characters look wrong.</p>
      </div></section>
    </>}
    {tool.id === 'json-beautifier' && <>
      <div class="hero"><h1 class="page-title">{entry.h1}</h1><div class="hero-row"><p class="lead"><strong>Make JSON easier to read.</strong> Paste text or choose a file, pick an indentation style, and copy or download the formatted result. Everything runs in your browser.</p><p class="caption">.json and .txt files up to 10 MB</p></div></div>
      <JsonBeautifierTool />
      <section aria-labelledby="how-title"><div class="sec-head"><h2 id="how-title">How it works</h2></div><div class="how-copy">
        <p>The beautifier checks that your input is valid JSON, then adds line breaks and indentation. Choose 2 spaces, 4 spaces or tabs. Compact removes optional whitespace when you need a smaller text file. The output can be copied or downloaded as .json.</p>
        <p>Objects, arrays, strings, numbers, booleans and null are accepted at the top level. Integer digits larger than JavaScript can safely represent are preserved. As with JSON parsing generally, duplicate object keys collapse to their last value, and object keys made only of integer digits may be reordered.</p>
        <p>For invalid JSON, the message points to a line and column and suggests a fix for common problems such as trailing commas, single quotes and unquoted keys. JSON Lines, comments and JSON with trailing commas are not accepted as standard JSON. Files up to 10 MB are processed locally in a Web Worker; large files may use substantial memory on a phone.</p>
      </div></section>
    </>}
    {tool.id === 'csv-to-sql' && <>
      <div class="hero"><h1 class="page-title">{entry.h1}</h1><div class="hero-row"><p class="lead"><strong>Turn CSV rows into SQL INSERT statements.</strong> Paste data or choose a file, select your database, then copy or download the generated SQL. Conversion happens in your browser.</p><p class="caption">.csv, .tsv and .txt files up to 10 MB</p></div></div>
      <CsvToSqlTool />
      <section aria-labelledby="how-title"><div class="sec-head"><h2 id="how-title">How CSV becomes SQL</h2></div><div class="how-copy">
        <p>The first CSV row becomes column names by default. Each remaining row becomes values in an INSERT statement. You can include a CREATE TABLE statement, combine up to 500 rows per INSERT, and choose PostgreSQL, MySQL, SQLite or SQL Server quoting.</p>
        <h3>What happens to values</h3>
        <div class="table-scroll"><table class="spec-table mapping-table"><thead><tr><th scope="col">CSV input</th><th scope="col">SQL output</th></tr></thead><tbody>
          <tr><td><code>001</code></td><td><code>'001'</code> by default, so leading zeros survive. Turn on type detection only if the destination column expects a number.</td></tr>
          <tr><td><code>O'Neil</code></td><td><code>'O''Neil'</code>. Apostrophes are escaped, and identifiers are quoted for the chosen database.</td></tr>
          <tr><td>An empty field</td><td><code>''</code> by default. Choose “Convert empty fields to NULL” when missing values should be SQL <code>NULL</code>.</td></tr>
          <tr><td>A quoted field with a comma or line break</td><td>One text value. The CSV parser keeps quoted fields together and decodes doubled quotes.</td></tr>
        </tbody></table></div>
        <p>Auto detect checks comma, semicolon, tab and pipe separators. If the preview looks wrong, choose the separator explicitly. Blank and duplicate column names get unique names so the SQL remains usable. Type detection recognizes booleans and conservative integer or decimal values; dates stay text because date formats vary by database.</p>
        <p>The full result is available through Copy SQL or Download .sql. The on-page SQL preview shows its beginning when output is long, and the table preview shows the first 100 rows and 30 columns. Large files can take longer on a phone. For MySQL, backslashes are escaped using its usual string syntax; review that output if your server uses <code>NO_BACKSLASH_ESCAPES</code>.</p>
      </div></section>
    </>}
    {tool.id === 'json-to-html' && <>
      <div class="hero"><h1 class="page-title">{entry.h1}</h1><div class="hero-row"><p class="lead"><strong>{t('tool.leadStrong', locale)}</strong> {t('tool.lead', locale)}</p><p class="caption">{t('tool.caption', locale)}</p></div></div>
      <TextToolFrame {locale} />
      <section aria-labelledby="how-title">
        <div class="sec-head"><h2 id="how-title">{t('how.title', locale)}</h2></div>
        <div class="how-copy">
          <p>{t('how.intro', locale)}</p>
          <h3>{t('how.mapTitle', locale)}</h3>
          <div class="table-scroll"><table class="spec-table mapping-table"><thead><tr><th scope="col">{t('how.yourJson', locale)}</th><th scope="col">{t('how.youGet', locale)}</th></tr></thead>
            <tbody>
              <tr><td>{t('how.arrayObjects', locale)}</td><td>{t('how.arrayObjectsResult', locale)}</td></tr>
              <tr><td>{t('how.object', locale)}</td><td>{t('how.objectResult', locale)}</td></tr>
              <tr><td>{t('how.nested', locale)}</td><td>{t('how.nestedResult', locale)}</td></tr>
              <tr><td>{t('how.simple', locale)}</td><td>{t('how.simpleResult', locale)}</td></tr>
            </tbody></table></div>
          <p>{t('how.layouts', locale)}</p><p>{t('how.outputs', locale)}</p><p>{t('how.limits', locale)}</p><p>{t('how.errors', locale)}</p>
        </div>
      </section>
    </>}
    {tool.id === 'excel-to-csv' && <>
      <div class="hero"><h1 class="page-title">{entry.h1}</h1><div class="hero-row"><p class="lead"><strong>{t('excel.leadStrong', locale)}</strong> {t('excel.lead', locale)}</p><p class="caption">{t('excel.caption', locale)}</p></div></div>
      <ExcelToCsvTool {locale} />
      <section aria-labelledby="how-title">
        <div class="sec-head"><h2 id="how-title">{t('how.title', locale)}</h2></div>
        <div class="how-copy">
          <p>{t('excel.howIntro', locale)}</p>
          <h3>{t('excel.howMapTitle', locale)}</h3>
          <div class="table-scroll"><table class="spec-table mapping-table"><thead><tr><th scope="col">{t('excel.howInWorkbook', locale)}</th><th scope="col">{t('excel.howInCsv', locale)}</th></tr></thead>
            <tbody>{excelRows.map(([what, result]) => <tr><td>{t(what, locale)}</td><td>{t(result, locale)}</td></tr>)}</tbody></table></div>
          <p>{t('excel.howSeparators', locale)}</p><p>{t('excel.howEncoding', locale)}</p><p>{t('excel.howLimits', locale)}</p><p>{t('excel.howErrors', locale)}</p>
        </div>
      </section>
    </>}
    {tool.id === 'json-to-excel' && <>
      <div class="hero"><h1 class="page-title">{entry.h1}</h1><div class="hero-row"><p class="lead"><strong>{t('jsonExcel.leadStrong', locale)}</strong> {t('jsonExcel.lead', locale)}</p><p class="caption">{t('jsonExcel.caption', locale)}</p></div></div>
      <JsonToExcelTool {locale} />
      <section aria-labelledby="how-title">
        <div class="sec-head"><h2 id="how-title">{t('how.title', locale)}</h2></div>
        <div class="how-copy">
          <p>{t('jsonExcel.howIntro', locale)}</p>
          <h3>{t('jsonExcel.howMapTitle', locale)}</h3>
          <div class="table-scroll"><table class="spec-table mapping-table"><thead><tr><th scope="col">{t('jsonExcel.howYourJson', locale)}</th><th scope="col">{t('jsonExcel.howInWorkbook', locale)}</th></tr></thead>
            <tbody>{jsonExcelRows.map(([what, result]) => <tr><td>{t(what, locale)}</td><td>{t(result, locale)}</td></tr>)}</tbody></table></div>
          <p>{t('jsonExcel.howValues', locale)}</p><p>{t('jsonExcel.howNested', locale)}</p><p>{t('jsonExcel.howLimits', locale)}</p><p>{t('jsonExcel.howErrors', locale)}</p>
        </div>
      </section>
    </>}
    {tool.id === 'json-to-csv' && <>
      <div class="hero"><h1 class="page-title">{entry.h1}</h1><div class="hero-row"><p class="lead"><strong>{t('jsonCsv.leadStrong', locale)}</strong> {t('jsonCsv.lead', locale)}</p><p class="caption">{t('jsonCsv.caption', locale)}</p></div></div>
      <JsonToCsvTool {locale} />
      <section aria-labelledby="how-title">
        <div class="sec-head"><h2 id="how-title">{t('how.title', locale)}</h2></div>
        <div class="how-copy">
          <p>{t('jsonCsv.howIntro', locale)}</p>
          <h3>{t('jsonCsv.howMapTitle', locale)}</h3>
          <div class="table-scroll"><table class="spec-table mapping-table"><thead><tr><th scope="col">{t('jsonCsv.howYourJson', locale)}</th><th scope="col">{t('jsonCsv.howInCsv', locale)}</th></tr></thead><tbody>
            <tr><td>{t('jsonCsv.howArray', locale)}</td><td>{t('jsonCsv.howArrayResult', locale)}</td></tr>
            <tr><td>{t('jsonCsv.howObject', locale)}</td><td>{t('jsonCsv.howObjectResult', locale)}</td></tr>
            <tr><td>{t('jsonCsv.howNested', locale)}</td><td>{t('jsonCsv.howNestedResult', locale)}</td></tr>
            <tr><td>{t('jsonCsv.howList', locale)}</td><td>{t('jsonCsv.howListResult', locale)}</td></tr>
            <tr><td>{t('jsonCsv.howGrid', locale)}</td><td>{t('jsonCsv.howGridResult', locale)}</td></tr>
          </tbody></table></div>
          <p>{t('jsonCsv.howFormat', locale)}</p><p>{t('jsonCsv.howSafety', locale)}</p><p>{t('jsonCsv.howLimits', locale)}</p>
          <p><a href="/guides/json-to-csv/">{t('jsonCsv.guideLink', locale)}</a></p>
        </div>
      </section>
    </>}
    {tool.id === 'xml-to-csv' && <>
      <div class="hero"><h1 class="page-title">{entry.h1}</h1><div class="hero-row"><p class="lead"><strong>{t('xmlCsv.leadStrong', locale)}</strong> {t('xmlCsv.lead', locale)}</p><p class="caption">{t('xmlCsv.caption', locale)}</p></div></div>
      <XmlToCsvTool {locale} />
      <section aria-labelledby="how-title">
        <div class="sec-head"><h2 id="how-title">{t('how.title', locale)}</h2></div>
        <div class="how-copy">
          <p>{t('xmlCsv.howIntro', locale)}</p>
          <h3>{t('xmlCsv.howMapTitle', locale)}</h3>
          <div class="table-scroll"><table class="spec-table mapping-table"><thead><tr><th scope="col">{t('xmlCsv.howYourXml', locale)}</th><th scope="col">{t('xmlCsv.howInCsv', locale)}</th></tr></thead><tbody>
            <tr><td>{t('xmlCsv.howRecords', locale)}</td><td>{t('xmlCsv.howRecordsResult', locale)}</td></tr>
            <tr><td>{t('xmlCsv.howAttributes', locale)}</td><td>{t('xmlCsv.howAttributesResult', locale)}</td></tr>
            <tr><td>{t('xmlCsv.howNested', locale)}</td><td>{t('xmlCsv.howNestedResult', locale)}</td></tr>
            <tr><td>{t('xmlCsv.howRepeated', locale)}</td><td>{t('xmlCsv.howRepeatedResult', locale)}</td></tr>
          </tbody></table></div>
          <h3>{t('xmlCsv.howStepsTitle', locale)}</h3>
          <p>{t('xmlCsv.howSteps', locale)}</p>
          <p>{t('xmlCsv.howFormat', locale)}</p><p>{t('xmlCsv.howSafety', locale)}</p><p>{t('xmlCsv.howLimits', locale)}</p>
        </div>
      </section>
    </>}
    {tool.id === 'xml-to-json' && <>
      <div class="hero"><h1 class="page-title">{entry.h1}</h1><div class="hero-row"><p class="lead"><strong>{t('xmlJson.leadStrong', locale)}</strong> {t('xmlJson.lead', locale)}</p><p class="caption">{t('xmlJson.caption', locale)}</p></div></div>
      <XmlToJsonTool />
      <section aria-labelledby="how-title">
        <div class="sec-head"><h2 id="how-title">How XML becomes JSON</h2></div>
        <div class="how-copy">
          <p>Paste XML or choose a local file, then convert it into valid JSON. The document root remains the top-level key. Conversion runs in a Web Worker in your browser; the XML is not uploaded.</p>
          <h3>Mapping rules</h3>
          <div class="table-scroll"><table class="spec-table mapping-table"><thead><tr><th scope="col">XML input</th><th scope="col">JSON output</th></tr></thead><tbody>
            <tr><td><code>&lt;name&gt;Maya&lt;/name&gt;</code></td><td><code>"name": "Maya"</code>. Text values stay strings, including numbers such as <code>001</code>.</td></tr>
            <tr><td><code>&lt;order id="A-104"&gt;</code></td><td>The attribute becomes <code>"@_id": "A-104"</code>. Choose <code>@id</code> if your importer uses that convention.</td></tr>
            <tr><td>Two or more sibling <code>&lt;tag&gt;</code> elements</td><td>They become a <code>"tag"</code> array, in source order. Turn on “Always use arrays” for consistent arrays even when one element appears.</td></tr>
            <tr><td>Text and child elements together</td><td><code>#text</code> holds the combined text; <code>#content</code> keeps text and child elements in source order.</td></tr>
            <tr><td>An empty element or CDATA</td><td><code>&lt;empty/&gt;</code> becomes an empty string. CDATA becomes ordinary text. XML entities are decoded.</td></tr>
          </tbody></table></div>
          <h3>Example</h3>
          <p><code>&lt;person id="7"&gt;&lt;name&gt;Maya&lt;/name&gt;&lt;name&gt;Luis&lt;/name&gt;&lt;/person&gt;</code> becomes <code>{'{"person":{"@_id":"7","name":["Maya","Luis"]}}'}</code>. Use Pretty print to make the output easier to read, or turn it off for compact JSON.</p>
          <p>XML has attributes, namespaces, comments and mixed content; JSON has no single standard way to represent them. This converter keeps namespace prefixes in names and omits comments and processing instructions. Simple text and <code>#text</code> are trimmed; <code>#content</code> retains the spaces around inline elements. It rejects DOCTYPE declarations and malformed XML, with a line and column for syntax errors.</p>
          <p>Choose a .xml or .txt file up to 10 MB. Copy the complete JSON or download a .json file. Large inputs can take longer on a phone. Need spreadsheet rows instead? Try <a href="/xml-to-csv/">XML to CSV</a>.</p>
        </div>
      </section>
    </>}
  </main>
</Tool>
