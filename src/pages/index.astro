---
import Base from '../layouts/Base.astro';
import { t } from '../i18n/utils';
import { tools } from '../data/tools';
const tool = tools.jsonToHtml.locales.en!;
const jsonExcel = tools.jsonToExcel.locales.en!;
const jsonCsv = tools.jsonToCsv.locales.en!;
const xmlCsv = tools.xmlToCsv.locales.en!;
const xmlJson = tools.xmlToJson.locales.en!;
const excel = tools.excelToCsv.locales.en!;
const dbfExcel = tools.dbfToExcel.locales.en!;
const csvSql = tools.csvToSql.locales.en!;
const jsonBeautifier = tools.jsonBeautifier.locales.en!;
const csvViewer = tools.csvViewer.locales.en!;
const csvJson = tools.csvToJson.locales.en!;
const qrScanner = tools.qrCodeScanner.locales.en!;
const imageResizer = tools.imageResizer.locales.en!;
const jpg100 = tools.compressJpg100kb.locales.en!;
const jpg50 = tools.compressJpg50kb.locales.en!;
const pdf = tools.compressPdf.locales.en!;
const pdf100 = tools.compressPdf100kb.locales.en!;
const pdf200 = tools.compressPdf200kb.locales.en!;
const pdf500 = tools.compressPdf500kb.locales.en!;
---
<Base locale="en" title={t('home.title')} description={t('home.description')} path="/">
  <main class="wrap">
    <div class="hero"><h1 class="page-title">{t('home.h1')}</h1><p class="lead"><strong>{t('home.leadStrong')}</strong> {t('home.lead')}</p></div>
    <section aria-labelledby="file-tools"><div class="sec-head"><h2 id="file-tools">{t('home.fileTools')}</h2></div>
      <div class="table-scroll"><table class="spec-table"><thead><tr><th scope="col">{t('home.tool')}</th><th scope="col">{t('home.takes')}</th><th scope="col">{t('home.gives')}</th><th scope="col">{t('home.goodFor')}</th></tr></thead>
        <tbody><tr><td><a href={pdf.path}>{pdf.h1}</a></td><td class="fmt">PDF</td><td class="fmt">Smaller PDF</td><td class="note">Reducing PDF size with a measured result</td></tr>
        <tr><td><a href={pdf100.path}>{pdf100.h1}</a></td><td class="fmt">PDF</td><td class="fmt">PDF aiming for 100KB</td><td class="note">Checking a 100KB upload limit</td></tr>
        <tr><td><a href={pdf200.path}>{pdf200.h1}</a></td><td class="fmt">PDF</td><td class="fmt">PDF aiming for 200KB</td><td class="note">Checking a 200KB upload limit</td></tr>
        <tr><td><a href={pdf500.path}>{pdf500.h1}</a></td><td class="fmt">PDF</td><td class="fmt">PDF aiming for 500KB</td><td class="note">Checking a 500KB upload limit</td></tr>
        <tr><td><a href={imageResizer.path}>{imageResizer.h1}</a></td><td class="fmt">JPG, PNG, WebP</td><td class="fmt">Resized image or ZIP</td><td class="note">Resizing photos by pixels, cm or KB, including batches</td></tr>
        <tr><td><a href={jpg100.path}>{jpg100.h1}</a></td><td class="fmt">JPG photo</td><td class="fmt">JPG at or under 100KB</td><td class="note">Meeting a 100KB JPG upload limit</td></tr>
        <tr><td><a href={jpg50.path}>{jpg50.h1}</a></td><td class="fmt">JPG photo</td><td class="fmt">JPG at or under 50KB</td><td class="note">Meeting a 50KB JPG upload limit</td></tr>
        <tr><td><a href={qrScanner.path}>{qrScanner.h1}</a></td><td class="fmt">Camera, image or screenshot</td><td class="fmt">QR link or text</td><td class="note">Reading a QR code privately, without installing an app</td></tr>
        <tr><td><a href={csvJson.path}>{csvJson.h1}</a></td><td class="fmt">CSV text, .csv, .tsv</td><td class="fmt">JSON array or JSON Lines</td><td class="note">Turning table rows into API or data pipeline records</td></tr>
        <tr><td><a href={csvViewer.path}>{csvViewer.h1}</a></td><td class="fmt">CSV text, .csv, .tsv</td><td class="fmt">Searchable table, CSV, JSON</td><td class="note">Opening, filtering, editing and checking CSV rows locally</td></tr>
        <tr><td><a href={jsonBeautifier.path}>{jsonBeautifier.h1}</a></td><td class="fmt">JSON text, .json</td><td class="fmt">Formatted JSON</td><td class="note">Reading, validating and sharing JSON with consistent indentation</td></tr>
        <tr><td><a href={tool.path}>{tool.h1}</a></td><td class="fmt">{t('home.jsonInput')}</td><td class="fmt">{t('home.htmlOutput')}</td><td class="note">{t('home.goodForText')}</td></tr>
        <tr><td><a href={jsonExcel.path}>{jsonExcel.h1}</a></td><td class="fmt">{t('home.jsonExcelInput')}</td><td class="fmt">{t('home.xlsxOutput')}</td><td class="note">{t('home.jsonExcelGoodFor')}</td></tr>
        <tr><td><a href={jsonCsv.path}>{jsonCsv.h1}</a></td><td class="fmt">{t('home.jsonInput')}</td><td class="fmt">{t('home.csvOutput')}</td><td class="note">{t('home.jsonCsvGoodFor')}</td></tr>
        <tr><td><a href={xmlCsv.path}>{xmlCsv.h1}</a></td><td class="fmt">{t('home.xmlInput')}</td><td class="fmt">{t('home.csvOutput')}</td><td class="note">{t('home.xmlCsvGoodFor')}</td></tr>
        <tr><td><a href={xmlJson.path}>{xmlJson.h1}</a></td><td class="fmt">{t('home.xmlInput')}</td><td class="fmt">{t('home.xmlJsonOutput')}</td><td class="note">{t('home.xmlJsonGoodFor')}</td></tr>
        <tr><td><a href={excel.path}>{excel.h1}</a></td><td class="fmt">{t('home.excelInput')}</td><td class="fmt">{t('home.csvOutput')}</td><td class="note">{t('home.excelGoodFor')}</td></tr>
        <tr><td><a href={dbfExcel.path}>{dbfExcel.h1}</a></td><td class="fmt">DBF table</td><td class="fmt">XLSX workbook</td><td class="note">Opening dBASE or FoxPro records in Excel</td></tr>
        <tr><td><a href={csvSql.path}>{csvSql.h1}</a></td><td class="fmt">CSV text, .csv, .tsv</td><td class="fmt">SQL statements, .sql</td><td class="note">Loading CSV rows into PostgreSQL, MySQL, SQLite or SQL Server</td></tr></tbody></table></div>
    </section>
    <section aria-labelledby="json-guides"><div class="sec-head"><h2 id="json-guides">{t('home.guidesTitle')}</h2><p>{t('home.guidesIntro')}</p></div>
      <div class="table-scroll"><table class="spec-table mapping-table"><thead><tr><th scope="col">{t('home.guideColumn')}</th><th scope="col">{t('home.coversColumn')}</th></tr></thead>
        <tbody>
          <tr><td><a href="/guides/json/">{t('home.jsonGuideTitle')}</a></td><td class="note">{t('home.jsonGuideDescription')}</td></tr>
          <tr><td><a href="/guides/json-syntax-square-brackets/">{t('home.bracketsGuideTitle')}</a></td><td class="note">{t('home.bracketsGuideDescription')}</td></tr>
          <tr><td><a href="/guides/json-to-csv/">{t('home.jsonCsvGuideTitle')}</a></td><td class="note">{t('home.jsonCsvGuideDescription')}</td></tr>
        </tbody></table></div>
    </section>
    <section class="home-open-source" aria-labelledby="open-source"><div class="sec-head"><h2 id="open-source">{t('home.openSourceTitle')}</h2><p>{t('home.openSourceText')}</p></div>
      <a class="source-link" href="https://github.com/harshit-dixit/thetoolproject.com">{t('home.openSourceLink')} <span aria-hidden="true">↗</span></a>
    </section>
  </main>
</Base>
