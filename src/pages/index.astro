---
import Base from '../layouts/Base.astro';
import { t } from '../i18n/utils';
import { tools } from '../data/tools';
const tool = tools.jsonToHtml.locales.en!;
const jsonExcel = tools.jsonToExcel.locales.en!;
const jsonCsv = tools.jsonToCsv.locales.en!;
const xmlCsv = tools.xmlToCsv.locales.en!;
const xmlJson = tools.xmlToJson.locales.en!;
const excel = tools.excelToCsv.locales.en!;
const csvSql = tools.csvToSql.locales.en!;
---
<Base locale="en" title={t('home.title')} description={t('home.description')} path="/">
  <main class="wrap">
    <div class="hero"><h1 class="page-title">{t('home.h1')}</h1><p class="lead"><strong>{t('home.leadStrong')}</strong> {t('home.lead')}</p></div>
    <section aria-labelledby="file-tools"><div class="sec-head"><h2 id="file-tools">{t('home.fileTools')}</h2></div>
      <div class="table-scroll"><table class="spec-table"><thead><tr><th scope="col">{t('home.tool')}</th><th scope="col">{t('home.takes')}</th><th scope="col">{t('home.gives')}</th><th scope="col">{t('home.goodFor')}</th></tr></thead>
        <tbody><tr><td><a href={tool.path}>{tool.h1}</a></td><td class="fmt">{t('home.jsonInput')}</td><td class="fmt">{t('home.htmlOutput')}</td><td class="note">{t('home.goodForText')}</td></tr>
        <tr><td><a href={jsonExcel.path}>{jsonExcel.h1}</a></td><td class="fmt">{t('home.jsonExcelInput')}</td><td class="fmt">{t('home.xlsxOutput')}</td><td class="note">{t('home.jsonExcelGoodFor')}</td></tr>
        <tr><td><a href={jsonCsv.path}>{jsonCsv.h1}</a></td><td class="fmt">{t('home.jsonInput')}</td><td class="fmt">{t('home.csvOutput')}</td><td class="note">{t('home.jsonCsvGoodFor')}</td></tr>
        <tr><td><a href={xmlCsv.path}>{xmlCsv.h1}</a></td><td class="fmt">{t('home.xmlInput')}</td><td class="fmt">{t('home.csvOutput')}</td><td class="note">{t('home.xmlCsvGoodFor')}</td></tr>
        <tr><td><a href={xmlJson.path}>{xmlJson.h1}</a></td><td class="fmt">{t('home.xmlInput')}</td><td class="fmt">{t('home.xmlJsonOutput')}</td><td class="note">{t('home.xmlJsonGoodFor')}</td></tr>
        <tr><td><a href={excel.path}>{excel.h1}</a></td><td class="fmt">{t('home.excelInput')}</td><td class="fmt">{t('home.csvOutput')}</td><td class="note">{t('home.excelGoodFor')}</td></tr>
        <tr><td><a href={csvSql.path}>{csvSql.h1}</a></td><td class="fmt">CSV text, .csv, .tsv</td><td class="fmt">SQL statements, .sql</td><td class="note">Loading CSV rows into PostgreSQL, MySQL, SQLite or SQL Server</td></tr></tbody></table></div>
    </section>
    <section aria-labelledby="json-guides"><div class="sec-head"><h2 id="json-guides">{t('home.guidesTitle')}</h2><p>{t('home.guidesIntro')}</p></div>
      <div class="table-scroll"><table class="spec-table mapping-table"><thead><tr><th scope="col">{t('home.guideColumn')}</th><th scope="col">{t('home.coversColumn')}</th></tr></thead>
        <tbody>
          <tr><td><a href="/guides/json/">{t('home.jsonGuideTitle')}</a></td><td class="note">{t('home.jsonGuideDescription')}</td></tr>
          <tr><td><a href="/guides/json-syntax-square-brackets/">{t('home.bracketsGuideTitle')}</a></td><td class="note">{t('home.bracketsGuideDescription')}</td></tr>
          <tr><td><a href="/guides/json-to-csv/">{t('home.jsonCsvGuideTitle')}</a></td><td class="note">{t('home.jsonCsvGuideDescription')}</td></tr>
        </tbody></table></div>
    </section>
    <section class="home-open-source" aria-labelledby="open-source"><div class="sec-head"><h2 id="open-source">{t('home.openSourceTitle')}</h2><p>{t('home.openSourceText')}</p></div>
      <a class="source-link" href="https://github.com/harshit-dixit/thetoolproject.com">{t('home.openSourceLink')} <span aria-hidden="true">↗</span></a>
    </section>
  </main>
</Base>
