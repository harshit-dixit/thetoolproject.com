---
import { t, type TranslationKey } from '../i18n/utils';
import type { Locale } from '../data/tools';

interface Props { mode: 'resize' | 'compress'; targetKb?: 50 | 100; locale?: Locale }
const { mode, targetKb = 100, locale = 'en' } = Astro.props;
const resize = mode === 'resize';

const clientKeys: TranslationKey[] = [
  'image.download', 'image.errBatchLimit', 'image.errCanvas', 'image.errDimPositive',
  'image.errDpiRange', 'image.errEstimate', 'image.errFitLimit', 'image.errGenericProcess',
  'image.errKbRange', 'image.errNoDimensions', 'image.errOutputTooLarge', 'image.errPercentRange',
  'image.errRead', 'image.errReadGeneric', 'image.errSaveFormat', 'image.errSingleJpg',
  'image.errUnsupportedType', 'image.estimatedForFile', 'image.estimatedOtherNote',
  'image.estimatedSize', 'image.estimating', 'image.exactBytes', 'image.formatsResize',
  'image.hintBox', 'image.hintCm', 'image.previewing', 'image.processedCount.one',
  'image.processedCount.other', 'image.processing', 'image.readyToProcess',
  'image.selectedCount.one', 'image.selectedCount.other', 'unit.bytes', 'unit.kb', 'unit.mb'
];
const strings = Object.fromEntries(clientKeys.map(key => [key, t(key, locale)]));
---
<div class="image-tool" id="image-tool" data-mode={mode} data-target-kb={targetKb} data-strings={JSON.stringify(strings)} data-locale={locale}>
  <div class="image-tool-head"><div><h2>{resize ? t('image.chooseHeading', locale) : t('image.chooseHeadingJpg', locale)}</h2><p>{resize ? t('image.chooseSubheading', locale) : t('image.chooseSubheadingJpg', locale, { target: targetKb })}</p></div><span>{t('image.processedOnDevice', locale)}</span></div>
  <div class="image-drop" id="image-drop">
    <svg viewBox="0 0 64 64" fill="none" aria-hidden="true"><rect x="8" y="11" width="48" height="42" rx="3" stroke="currentColor" stroke-width="2.5"/><circle cx="23" cy="25" r="4" stroke="currentColor" stroke-width="2.5"/><path d="m10 45 14-12 9 8 9-12 13 15" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round"/></svg>
    <h3>{resize ? t('image.dropTitle', locale) : t('image.dropTitleJpg', locale)}</h3><p>{resize ? t('image.dropHint', locale) : t('image.dropHintJpg', locale)}</p>
    <input id="image-files" type="file" accept={resize ? 'image/jpeg,image/png,image/webp,.jpg,.jpeg,.png,.webp' : 'image/jpeg,.jpg,.jpeg'} multiple={resize} class="visually-hidden" tabindex="-1" />
    <button class="btn" type="button" id="image-choose">{resize ? t('image.chooseButton', locale) : t('image.chooseButtonJpg', locale)}</button>
    <small>{resize ? t('image.dropLimit', locale) : t('image.dropLimitJpg', locale)}</small>
  </div>
  <div class="image-workspace" id="image-workspace" hidden>
    <div class="image-selected"><div><h3 id="image-selection-title">{t('image.selectedHeading', locale)}</h3><p id="image-selection-detail"></p></div><button type="button" id="image-change">{resize ? t('image.changeButton', locale) : t('image.changeButtonJpg', locale)}</button></div>
    <div class="image-preview-row"><div class="image-preview"><img id="image-before" alt={t('image.previewAlt', locale)} /></div><div class="image-preview-copy"><span>{t('image.original', locale)}</span><strong id="image-original-size"></strong><span id="image-original-dimensions"></span><p>{resize ? t('image.batchNote', locale) : t('image.jpgNote', locale, { target: targetKb })}</p></div></div>
    {resize && <div class="image-settings">
      <fieldset class="image-modes"><legend>{t('image.resizeBy', locale)}</legend><label><input type="radio" name="resize-mode" value="pixels" checked /> {t('image.modePixels', locale)}</label><label><input type="radio" name="resize-mode" value="percent" /> {t('image.modePercent', locale)}</label><label><input type="radio" name="resize-mode" value="cm" /> {t('image.modeCm', locale)}</label><label><input type="radio" name="resize-mode" value="kb" /> {t('image.modeKb', locale)}</label></fieldset>
      <div class="image-fields" id="image-dim-fields"><label><span>{t('image.width', locale)} <b id="image-width-unit">px</b></span><input id="image-width" type="number" min="1" max="16000" step="1" inputmode="decimal" /></label><label><span>{t('image.height', locale)} <b id="image-height-unit">px</b></span><input id="image-height" type="number" min="1" max="16000" step="1" inputmode="decimal" /></label><label id="image-dpi-field" hidden><span>{t('image.dpi', locale)}</span><input id="image-dpi" type="number" min="1" max="1200" value="300" step="1" inputmode="numeric" /></label></div>
      <div class="image-fields" id="image-percent-field" hidden><label><span>{t('image.scale', locale)}</span><div class="image-suffix"><input id="image-percent" type="number" min="1" max="500" value="50" step="1" inputmode="numeric" /><span>%</span></div></label><div class="image-range"><input id="image-percent-slider" type="range" min="1" max="500" value="50" step="1" aria-label={t('image.scaleAria', locale)} /><div class="image-range-ends" aria-hidden="true"><span>1%</span><span>500%</span></div></div></div>
      <div class="image-fields" id="image-kb-field" hidden><label><span>{t('image.maxFileSize', locale)}</span><div class="image-suffix"><input id="image-kb" type="number" min="1" max="20000" value="100" step="1" inputmode="numeric" /><span>KB</span></div></label></div>
      <div class="image-settings-row" id="image-dim-options"><label class="image-check"><input id="image-lock" type="checkbox" checked /> {t('image.lockAspect', locale)}</label><label class="image-check"><input id="image-no-enlarge" type="checkbox" checked /> {t('image.noEnlarge', locale)}</label></div>
      <div class="image-format-row" id="image-format-row"><label for="image-format">{t('image.saveAs', locale)}</label><select id="image-format"><option value="original">{t('image.formatOriginal', locale)}</option><option value="image/jpeg">JPG</option><option value="image/png">PNG</option><option value="image/webp">WebP</option></select><p id="image-mode-hint">{t('image.hintBox', locale)}</p></div>
    </div>}
    {resize && <div class="image-estimate"><button type="button" class="btn alt" id="image-estimate-button">{t('image.estimateButton', locale)}</button><p id="image-estimate-result" role="status" aria-live="polite" hidden></p></div>}
    <div class="image-action"><button type="button" class="btn" id="image-run">{resize ? t('image.runButton', locale) : t('image.runButtonCompress', locale, { target: targetKb })}</button><p>{t('image.nothingUploaded', locale)}</p></div>
  </div>
  <p class="image-status" id="image-status" role="status" aria-live="polite" hidden></p>
  <div class="image-results" id="image-results" hidden><div class="image-results-head"><h3>{t('image.readyToDownload', locale)}</h3><p id="image-results-summary"></p></div><div id="image-result-list" class="image-result-list"></div><button type="button" class="btn alt" id="image-download-all" hidden>{t('image.downloadAllZip', locale)}</button></div>
</div>
<style>
  .image-tool { margin-block-start: 40px; border: 2px solid var(--ink); border-radius: 4px; background: var(--paper); overflow: hidden; }
  .image-tool-head { display: flex; justify-content: space-between; align-items: center; gap: 20px; padding: 26px 30px; border-block-end: 1px solid var(--line); }
  .image-tool-head h2 { font-size: 30px; font-stretch: 88%; line-height: 1.1; margin: 0 0 6px; }
  .image-tool-head p, .image-selected p { margin: 0; color: var(--slate); }
  .image-tool-head > span { color: var(--cobalt); font-size: 14px; font-weight: 600; white-space: nowrap; }
  .image-drop { min-height: 300px; margin: 28px 30px; padding: 32px; border: 2px dashed #a8b0bf; background: #f8f9fb; display: grid; align-content: center; justify-items: center; text-align: center; border-radius: 3px; }
  .image-drop.over { background: var(--cobalt-wash); border-color: var(--cobalt); }
  .image-drop svg { width: 58px; height: 58px; color: var(--cobalt); margin-block-end: 14px; }
  .image-drop h3 { margin: 0; font-size: 26px; font-stretch: 88%; line-height: 1.15; }
  .image-drop p { margin: 6px 0 20px; color: var(--slate); }
  .image-drop small { margin-block-start: 14px; color: var(--slate); }
  .image-workspace { padding: 26px 30px 30px; }
  .image-selected, .image-results-head { display: flex; justify-content: space-between; align-items: center; gap: 16px; }
  .image-selected h3, .image-results h3 { margin: 0 0 4px; font-size: 23px; font-stretch: 88%; }
  .image-selected button { border: 0; background: none; color: var(--cobalt); font: inherit; font-weight: 600; text-decoration: underline; cursor: pointer; }
  .image-preview-row { display: grid; grid-template-columns: minmax(0, 1fr) 230px; gap: 22px; margin-block: 22px 28px; align-items: center; }
  .image-preview { display: grid; place-items: center; min-height: 180px; max-height: 280px; padding: 10px; background: #eff1f5; overflow: hidden; }
  .image-preview img { display: block; max-width: 100%; max-height: 260px; object-fit: contain; }
  .image-preview-copy { display: grid; gap: 4px; color: var(--slate); }
  .image-preview-copy strong { color: var(--ink); font-size: 24px; }
  .image-preview-copy p { margin: 14px 0 0; font-size: 14px; }
  .image-settings { border-block-start: 1px solid var(--line); padding-block-start: 24px; }
  .image-modes { display: flex; flex-wrap: wrap; gap: 8px; padding: 0; margin: 0 0 22px; border: 0; }
  .image-modes legend { font-weight: 600; margin-block-end: 10px; }
  .image-modes label { display: inline-flex; align-items: center; gap: 7px; padding: 9px 13px; border: 1.5px solid var(--line); border-radius: 3px; cursor: pointer; font-weight: 600; }
  .image-modes label:has(input:checked) { border-color: var(--cobalt); background: var(--cobalt-wash); color: var(--cobalt); }
  .image-modes input { accent-color: var(--cobalt); }
  .image-fields { display: flex; flex-wrap: wrap; gap: 15px; margin-block-end: 18px; }
  .image-fields label { display: grid; gap: 6px; font-weight: 600; min-width: 140px; }
  .image-fields input[type="number"] { height: 42px; border: 1.5px solid var(--ink); border-radius: 3px; padding: 0 10px; font: inherit; background: var(--paper); }
  .image-suffix { position: relative; display: grid; }
  .image-suffix input { padding-inline-end: 32px; }
  .image-suffix span { position: absolute; inset-inline-end: 10px; inset-block: 0; display: grid; align-content: center; color: var(--slate); pointer-events: none; }
  .image-range { display: grid; gap: 4px; min-width: 220px; align-content: end; }
  .image-range input[type="range"] { accent-color: var(--cobalt); }
  .image-range-ends { display: flex; justify-content: space-between; font-size: 12px; color: var(--slate); }
  .image-settings-row { display: flex; flex-wrap: wrap; gap: 18px; margin-block-end: 18px; }
  .image-check { display: inline-flex; align-items: center; gap: 8px; font-weight: 600; cursor: pointer; }
  .image-check input { accent-color: var(--cobalt); }
  .image-format-row { display: flex; flex-wrap: wrap; align-items: center; gap: 14px; border-block-start: 1px solid var(--line); padding-block-start: 18px; }
  .image-format-row label { font-weight: 600; }
  .image-format-row select { height: 40px; border: 1.5px solid var(--ink); border-radius: 3px; background: var(--paper); padding: 0 10px; font: inherit; }
  .image-format-row p { margin: 0; color: var(--slate); font-size: 14px; flex-basis: 100%; }
  .image-estimate { border-block-start: 1px solid var(--line); padding-block-start: 18px; margin-block-start: 18px; display: flex; flex-wrap: wrap; align-items: center; gap: 14px; }
  .image-estimate p { margin: 0; color: var(--slate); }
  .image-action { border-block-start: 1px solid var(--line); padding-block-start: 22px; margin-block-start: 22px; display: flex; align-items: center; gap: 16px; }
  .image-action p { margin: 0; color: var(--slate); font-size: 14px; }
  .image-status { padding: 16px 30px; margin: 0; border-block-start: 1px solid var(--line); background: var(--paper-warm); font-weight: 600; }
  .image-status.error { background: #fee2e2; color: #991b1b; }
  .image-results { border-block-start: 1px solid var(--line); background: var(--paper-warm); padding: 26px 30px 30px; }
  .image-result-list { display: grid; gap: 12px; margin-block: 18px 22px; }
  .image-result-row { display: grid; grid-template-columns: 56px minmax(0, 1fr) auto; gap: 14px; align-items: center; background: var(--paper); border: 1px solid var(--line); border-radius: 3px; padding: 10px 14px; }
  .image-result-row img { width: 56px; height: 56px; object-fit: contain; background: #eff1f5; }
  .image-result-row strong { display: block; overflow-wrap: anywhere; }
  .image-result-row span { color: var(--slate); font-size: 14px; }
  .image-result-row a { font-weight: 600; text-decoration: underline; color: var(--cobalt); }
  @media (max-width: 640px) {
    .image-tool-head, .image-preview-row, .image-action { display: grid; grid-template-columns: 1fr; }
    .image-tool-head, .image-drop, .image-workspace, .image-status, .image-results { padding-inline: 18px; }
    .image-drop { margin-inline: 18px; }
    .image-result-row { grid-template-columns: 1fr; }
  }
</style>
<script src="../scripts/image-tool.ts"></script>
