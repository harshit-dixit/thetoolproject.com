---
import { t, type TranslationKey } from '../i18n/utils';
import type { Locale } from '../data/tools';

interface Props { locale?: Locale }
const { locale = 'en' } = Astro.props;

const clientKeys: TranslationKey[] = [
  'jsonBeautifier.copied', 'jsonBeautifier.copiedClipboard', 'jsonBeautifier.copy',
  'jsonBeautifier.errClipboard', 'jsonBeautifier.errEmpty', 'jsonBeautifier.errRead',
  'jsonBeautifier.errSyntax', 'jsonBeautifier.errTooLarge', 'jsonBeautifier.errWorker',
  'jsonBeautifier.errWrongType', 'jsonBeautifier.fileLoaded', 'jsonBeautifier.fileTooLarge',
  'jsonBeautifier.inputHint', 'jsonBeautifier.reading', 'jsonBeautifier.reasonComment',
  'jsonBeautifier.reasonDepth', 'jsonBeautifier.reasonJsonLines', 'jsonBeautifier.reasonSingleQuote',
  'jsonBeautifier.reasonSyntax', 'jsonBeautifier.reasonTrailingComma',
  'jsonBeautifier.reasonUnquotedKey', 'jsonBeautifier.summary', 'jsonBeautifier.working',
  'unit.bytes', 'unit.kb', 'unit.mb'
];
const strings = Object.fromEntries(clientKeys.map(key => [key, t(key, locale)]));
---
<div class="drop" id="json-beautifier-tool" data-strings={JSON.stringify(strings)} data-locale={locale}>
  <div class="tool-frame">
    <label class="field-label" for="beautifier-input">{t('jsonBeautifier.inputLabel', locale)}</label>
    <textarea id="beautifier-input" class="json-input" rows="12" spellcheck="false" autocapitalize="off" autocomplete="off" placeholder={t('jsonBeautifier.inputPlaceholder', locale)}></textarea>
    <p class="input-hint" id="beautifier-hint">{t('jsonBeautifier.inputHint', locale)}</p>
    <div class="actions input-actions">
      <input class="visually-hidden" type="file" id="beautifier-file" accept=".json,.txt,application/json,text/plain" tabindex="-1" />
      <button class="btn alt" type="button" id="beautifier-choose">{t('jsonBeautifier.chooseFile', locale)}</button>
      <button class="text-button" type="button" id="beautifier-example">{t('jsonBeautifier.tryExample', locale)}</button>
    </div>
    <div class="file-line" id="beautifier-file-line" hidden><span class="file-name" id="beautifier-file-name"></span><span class="file-size" id="beautifier-file-size"></span></div>
    <div class="option-row"><fieldset><legend>{t('jsonBeautifier.indentation', locale)}</legend><div class="chips" role="group" aria-label={t('jsonBeautifier.indentation', locale)}>
      <button type="button" data-spacing="2" aria-pressed="true">{t('jsonBeautifier.spaces2', locale)}</button>
      <button type="button" data-spacing="4" aria-pressed="false">{t('jsonBeautifier.spaces4', locale)}</button>
      <button type="button" data-spacing="tab" aria-pressed="false">{t('jsonBeautifier.tabs', locale)}</button>
      <button type="button" data-spacing="compact" aria-pressed="false">{t('jsonBeautifier.compact', locale)}</button>
    </div></fieldset></div>
    <button class="btn" id="beautifier-format" type="button">{t('jsonBeautifier.formatButton', locale)}</button>
    <p id="beautifier-status" class="status" role="status" aria-live="polite" aria-atomic="true" hidden></p>
    <div id="beautifier-placeholder" class="preview-placeholder"><p>{t('jsonBeautifier.placeholder', locale)}</p></div>
    <div id="beautifier-result" class="result" hidden>
      <div class="result-head"><label class="field-label" for="beautifier-output">{t('jsonBeautifier.outputLabel', locale)}</label><p class="result-summary" id="beautifier-summary"></p></div>
      <textarea id="beautifier-output" class="code-view beautifier-output" readonly spellcheck="false" aria-label={t('jsonBeautifier.outputLabel', locale)}></textarea>
      <div class="actions"><button class="btn" id="beautifier-download" type="button">{t('jsonBeautifier.download', locale)}</button><button class="btn alt" id="beautifier-copy" type="button">{t('jsonBeautifier.copy', locale)}</button><button class="btn alt" id="beautifier-reset" type="button">{t('jsonBeautifier.startOver', locale)}</button></div>
    </div>
  </div>
</div>
<style>
  .beautifier-output { width: 100%; height: 360px; resize: vertical; background: var(--paper); color: var(--ink); }
  @media (max-width: 560px) { .beautifier-output { height: 300px; } }
</style>
<script src="../scripts/json-beautifier.ts"></script>
