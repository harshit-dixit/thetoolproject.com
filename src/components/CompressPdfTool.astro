---
interface Props { targetKb?: 100 | 200 | 500 }
const { targetKb } = Astro.props;
---
<div class="pdf-tool" id="pdf-tool" data-target-kb={targetKb ?? ''}>
  <div class="pdf-tool-head"><div><h2>Choose a PDF</h2><p>Compress one file and check its exact size before downloading.</p></div><span>Processed on your device</span></div>
  <div class="pdf-drop" id="pdf-drop">
    <svg viewBox="0 0 64 64" fill="none" aria-hidden="true"><path d="M15 5h24l11 11v42H15zM39 5v12h11M23 34h19M23 42h15" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
    <h3>Drop your PDF here</h3><p>or choose a file from your device</p>
    <input type="file" id="pdf-file" accept="application/pdf,.pdf" class="visually-hidden" tabindex="-1" />
    <button class="btn" id="pdf-choose" type="button">Choose PDF</button>
    <small>PDF only · up to 30MB · up to 60 pages</small>
  </div>
  <div class="pdf-workspace" id="pdf-workspace" hidden>
    <div class="pdf-selected"><div><strong id="pdf-name"></strong><span id="pdf-original-size"></span></div><button type="button" id="pdf-change">Change PDF</button></div>
    <div class="pdf-controls">
      <fieldset><legend>How should we compress it?</legend>
        <label><input type="radio" name="pdf-mode" value="visual" checked /><span><strong>Make it smaller</strong><small>Rebuild pages as images. Text, links and forms will no longer be interactive.</small></span></label>
        <label><input type="radio" name="pdf-mode" value="preserve" /><span><strong>Keep text and links</strong><small>Optimize PDF structure only. File size may barely change.</small></span></label>
      </fieldset>
      <div class="pdf-control-row"><label for="pdf-level">Compression level<select id="pdf-level"><option value="light">Light · clearer pages</option><option value="balanced" selected>Balanced</option><option value="strong">Strong · smaller pages</option></select></label>
        <label for="pdf-target">Maximum size<select id="pdf-target"><option value="">No fixed limit</option><option value="100" selected={targetKb === 100}>100KB</option><option value="200" selected={targetKb === 200}>200KB</option><option value="500" selected={targetKb === 500}>500KB</option></select></label></div>
      <p class="pdf-target-hint" id="pdf-target-hint">A size limit may be impossible for a long or complex PDF. We will show the actual result. Modified PDFs may lose valid digital signatures.</p>
    </div>
    <button type="button" class="btn" id="pdf-run">Compress PDF</button>
  </div>
  <p class="pdf-status" id="pdf-status" role="status" aria-live="polite" hidden></p>
  <div class="pdf-result" id="pdf-result" hidden>
    <div class="pdf-sizes"><div><span>Original</span><strong id="pdf-before"></strong></div><div><span>Compressed</span><strong id="pdf-after"></strong></div><div><span>Saved</span><strong id="pdf-saved"></strong></div></div>
    <p id="pdf-result-note"></p>
    <a class="btn" id="pdf-download" download>Download PDF</a>
  </div>
</div>
<style>
  .pdf-tool { margin-block-start: 40px; border: 2px solid var(--ink); border-radius: 4px; background: var(--paper); overflow: hidden; }
  .pdf-tool-head { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 25px 30px; border-block-end: 1px solid var(--line); }
  .pdf-tool-head h2 { font-size: 30px; font-stretch: 88%; line-height: 1.1; margin: 0 0 5px; }
  .pdf-tool-head p { color: var(--slate); margin: 0; }
  .pdf-tool-head > span { color: var(--cobalt); white-space: nowrap; font-size: 14px; font-weight: 600; }
  .pdf-drop { min-height: 300px; margin: 28px 30px; padding: 32px; border: 2px dashed #a8b0bf; background: #f8f9fb; display: grid; align-content: center; justify-items: center; text-align: center; border-radius: 3px; }
  .pdf-drop[hidden] { display: none; }
  .pdf-drop.over { background: var(--cobalt-wash); border-color: var(--cobalt); }
  .pdf-drop svg { width: 55px; height: 55px; color: var(--cobalt); margin-block-end: 13px; }
  .pdf-drop h3 { margin: 0; font-size: 26px; font-stretch: 88%; line-height: 1.15; }
  .pdf-drop p { color: var(--slate); margin: 6px 0 20px; }
  .pdf-drop small { color: var(--slate); margin-block-start: 14px; }
  .pdf-workspace, .pdf-result { padding: 26px 30px 30px; }
  .pdf-selected { display: flex; justify-content: space-between; gap: 16px; align-items: center; padding-block-end: 24px; border-block-end: 1px solid var(--line); }
  .pdf-selected div { display: grid; min-width: 0; }
  .pdf-selected strong { overflow-wrap: anywhere; font-size: 20px; }
  .pdf-selected span { color: var(--slate); }
  .pdf-selected button { border: 0; background: none; color: var(--cobalt); font: inherit; font-weight: 600; text-decoration: underline; cursor: pointer; white-space: nowrap; }
  .pdf-controls { padding-block: 24px; }
  .pdf-controls fieldset { border: 0; padding: 0; margin: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .pdf-controls legend { font-weight: 600; margin-block-end: 12px; }
  .pdf-controls fieldset label { display: flex; align-items: start; gap: 10px; padding: 16px; border: 1.5px solid var(--line); border-radius: 3px; cursor: pointer; }
  .pdf-controls fieldset label:has(input:checked) { border-color: var(--cobalt); background: var(--cobalt-wash); }
  .pdf-controls fieldset input { accent-color: var(--cobalt); margin-block-start: 4px; }
  .pdf-controls fieldset span { display: grid; gap: 4px; }
  .pdf-controls fieldset small { color: var(--slate); line-height: 1.45; }
  .pdf-control-row { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; margin-block-start: 24px; }
  .pdf-control-row label { font-weight: 600; }
  .pdf-control-row select { display: block; width: 100%; min-height: 44px; margin-block-start: 8px; padding: 8px 12px; border: 1.5px solid var(--line); border-radius: 3px; background: white; color: var(--ink); font: inherit; }
  .pdf-target-hint { color: var(--slate); font-size: 14px; margin: 14px 0 0; }
  .pdf-status { margin: 0 30px 28px; padding: 12px 15px; border-inline-start: 3px solid var(--cobalt); background: var(--cobalt-wash); }
  .pdf-status.error { border-color: #b33e31; background: #fff0ef; }
  .pdf-result { border-block-start: 1px solid var(--line); }
  .pdf-sizes { display: grid; grid-template-columns: repeat(3, 1fr); border: 1px solid var(--line); }
  .pdf-sizes div { display: grid; gap: 4px; padding: 16px; border-inline-end: 1px solid var(--line); }
  .pdf-sizes div:last-child { border-inline-end: 0; }
  .pdf-sizes span { color: var(--slate); font-size: 14px; }
  .pdf-sizes strong { font-size: clamp(20px, 3vw, 30px); font-stretch: 88%; font-variant-numeric: tabular-nums; }
  .pdf-result p { color: var(--slate); max-width: 68ch; }
  .pdf-result .btn { display: inline-flex; text-decoration: none; align-items: center; }
  @media (max-width: 680px) { .pdf-tool-head { align-items: start; flex-direction: column; } .pdf-tool-head, .pdf-workspace, .pdf-result { padding-inline: 20px; } .pdf-drop { margin-inline: 20px; } .pdf-controls fieldset, .pdf-control-row { grid-template-columns: 1fr; } .pdf-status { margin-inline: 20px; } }
</style>
<script src="../scripts/compress-pdf.ts"></script>
