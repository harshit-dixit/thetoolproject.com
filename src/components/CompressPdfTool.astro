---
import { t, type TranslationKey } from '../i18n/utils';
import type { Locale } from '../data/tools';

interface Props { targetKb?: 100 | 200 | 500; locale?: Locale }
const { targetKb, locale = 'en' } = Astro.props;

const clientKeys: TranslationKey[] = [
  'pdf.checkingStructure', 'pdf.compressingPage', 'pdf.errCanvas', 'pdf.errEncode', 'pdf.errGeneral',
  'pdf.errInvalidPdf', 'pdf.errNoPages', 'pdf.errNotPdf', 'pdf.errPageLimit',
  'pdf.errPasswordOrDamaged', 'pdf.errRender', 'pdf.errTooLarge', 'pdf.noteOptimized',
  'pdf.noteOriginal', 'pdf.noteVisual', 'pdf.opening', 'pdf.targetNotReached', 'pdf.targetReached',
  'unit.bytes', 'unit.kb', 'unit.mb'
];
const strings = Object.fromEntries(clientKeys.map(key => [key, t(key, locale)]));
---
<div class="pdf-tool" id="pdf-tool" data-target-kb={targetKb ?? ''} data-strings={JSON.stringify(strings)} data-locale={locale}>
  <div class="pdf-tool-head"><div><h2>{t('pdf.chooseHeading', locale)}</h2><p>{t('pdf.chooseSubheading', locale)}</p></div><span>{t('pdf.processedOnDevice', locale)}</span></div>
  <div class="pdf-drop" id="pdf-drop">
    <svg viewBox="0 0 64 64" fill="none" aria-hidden="true"><path d="M15 5h24l11 11v42H15zM39 5v12h11M23 34h19M23 42h15" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
    <h3>{t('pdf.dropTitle', locale)}</h3><p>{t('pdf.dropHint', locale)}</p>
    <input type="file" id="pdf-file" accept="application/pdf,.pdf" class="visually-hidden" tabindex="-1" />
    <button class="btn" id="pdf-choose" type="button">{t('pdf.chooseButton', locale)}</button>
    <small>{t('pdf.dropLimit', locale)}</small>
  </div>
  <div class="pdf-workspace" id="pdf-workspace" hidden>
    <div class="pdf-selected"><div><strong id="pdf-name"></strong><span id="pdf-original-size"></span></div><button type="button" id="pdf-change">{t('pdf.changeButton', locale)}</button></div>
    <div class="pdf-controls">
      <fieldset><legend>{t('pdf.howCompress', locale)}</legend>
        <label><input type="radio" name="pdf-mode" value="visual" checked /><span><strong>{t('pdf.makeSmaller', locale)}</strong><small>{t('pdf.makeSmallerDesc', locale)}</small></span></label>
        <label><input type="radio" name="pdf-mode" value="preserve" /><span><strong>{t('pdf.keepText', locale)}</strong><small>{t('pdf.keepTextDesc', locale)}</small></span></label>
      </fieldset>
      <div class="pdf-control-row"><label for="pdf-level">{t('pdf.levelLabel', locale)}<select id="pdf-level"><option value="light">{t('pdf.levelLight', locale)}</option><option value="balanced" selected>{t('pdf.levelBalanced', locale)}</option><option value="strong">{t('pdf.levelStrong', locale)}</option></select></label>
        <label for="pdf-target">{t('pdf.targetLabel', locale)}<select id="pdf-target"><option value="">{t('pdf.targetNone', locale)}</option><option value="100" selected={targetKb === 100}>{t('pdf.target100', locale)}</option><option value="200" selected={targetKb === 200}>{t('pdf.target200', locale)}</option><option value="500" selected={targetKb === 500}>{t('pdf.target500', locale)}</option></select></label></div>
      <p class="pdf-target-hint" id="pdf-target-hint">{t('pdf.targetHint', locale)}</p>
    </div>
    <button type="button" class="btn" id="pdf-run">{t('pdf.compressButton', locale)}</button>
  </div>
  <p class="pdf-status" id="pdf-status" role="status" aria-live="polite" hidden></p>
  <div class="pdf-result" id="pdf-result" hidden>
    <div class="pdf-sizes"><div><span>{t('pdf.original', locale)}</span><strong id="pdf-before"></strong></div><div><span>{t('pdf.compressed', locale)}</span><strong id="pdf-after"></strong></div><div><span>{t('pdf.saved', locale)}</span><strong id="pdf-saved"></strong></div></div>
    <p id="pdf-result-note"></p>
    <a class="btn" id="pdf-download" download>{t('pdf.download', locale)}</a>
  </div>
</div>
<style>
  .pdf-tool { margin-block-start: 40px; border: 2px solid var(--ink); border-radius: 4px; background: var(--paper); overflow: hidden; }
  .pdf-tool-head { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 25px 30px; border-block-end: 1px solid var(--line); }
  .pdf-tool-head h2 { font-size: 30px; font-stretch: 88%; line-height: 1.1; margin: 0 0 5px; }
  .pdf-tool-head p { color: var(--slate); margin: 0; }
  .pdf-tool-head > span { color: var(--cobalt); white-space: nowrap; font-size: 14px; font-weight: 600; }
  .pdf-drop { min-height: 300px; margin: 28px 30px; padding: 32px; border: 2px dashed #a8b0bf; background: #f8f9fb; display: grid; align-content: center; justify-items: center; text-align: center; border-radius: 3px; }
  .pdf-drop[hidden] { display: none; }
  .pdf-drop.over { background: var(--cobalt-wash); border-color: var(--cobalt); }
  .pdf-drop svg { width: 55px; height: 55px; color: var(--cobalt); margin-block-end: 13px; }
  .pdf-drop h3 { margin: 0; font-size: 26px; font-stretch: 88%; line-height: 1.15; }
  .pdf-drop p { color: var(--slate); margin: 6px 0 20px; }
  .pdf-drop small { color: var(--slate); margin-block-start: 14px; }
  .pdf-workspace, .pdf-result { padding: 26px 30px 30px; }
  .pdf-selected { display: flex; justify-content: space-between; gap: 16px; align-items: center; padding-block-end: 24px; border-block-end: 1px solid var(--line); }
  .pdf-selected div { display: grid; min-width: 0; }
  .pdf-selected strong { overflow-wrap: anywhere; font-size: 20px; }
  .pdf-selected span { color: var(--slate); }
  .pdf-selected button { border: 0; background: none; color: var(--cobalt); font: inherit; font-weight: 600; text-decoration: underline; cursor: pointer; white-space: nowrap; }
  .pdf-controls { padding-block: 24px; }
  .pdf-controls fieldset { border: 0; padding: 0; margin: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .pdf-controls legend { font-weight: 600; margin-block-end: 12px; }
  .pdf-controls fieldset label { display: flex; align-items: start; gap: 10px; padding: 16px; border: 1.5px solid var(--line); border-radius: 3px; cursor: pointer; }
  .pdf-controls fieldset label:has(input:checked) { border-color: var(--cobalt); background: var(--cobalt-wash); }
  .pdf-controls fieldset input { accent-color: var(--cobalt); margin-block-start: 4px; }
  .pdf-controls fieldset span { display: grid; gap: 4px; }
  .pdf-controls fieldset small { color: var(--slate); line-height: 1.45; }
  .pdf-control-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-block-start: 20px; }
  .pdf-control-row label { display: grid; gap: 6px; font-weight: 600; }
  .pdf-control-row select { height: 42px; border: 1.5px solid var(--ink); border-radius: 3px; background: var(--paper); padding: 0 10px; font: inherit; }
  .pdf-target-hint { color: var(--slate); margin: 12px 0 0; font-size: 14px; }
  .pdf-workspace > .btn { margin-block-start: 8px; }
  .pdf-status { padding: 16px 30px; margin: 0; border-block-start: 1px solid var(--line); background: var(--paper-warm); font-weight: 600; }
  .pdf-status.error { background: #fee2e2; color: #991b1b; }
  .pdf-result { border-block-start: 1px solid var(--line); background: var(--paper-warm); }
  .pdf-sizes { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-block-end: 18px; }
  .pdf-sizes div { display: grid; gap: 4px; }
  .pdf-sizes span { color: var(--slate); font-size: 14px; }
  .pdf-sizes strong { font-size: 24px; }
  .pdf-result p { margin: 0 0 20px; color: var(--slate); line-height: 1.5; }
  @media (max-width: 640px) {
    .pdf-tool-head, .pdf-selected, .pdf-controls fieldset, .pdf-control-row, .pdf-sizes { grid-template-columns: 1fr; display: grid; }
    .pdf-tool-head, .pdf-drop, .pdf-workspace, .pdf-result, .pdf-status { padding-inline: 18px; }
    .pdf-drop { margin-inline: 18px; }
  }
</style>
<script src="../scripts/compress-pdf.ts"></script>
