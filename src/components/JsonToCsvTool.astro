---
import { t, type TranslationKey } from '../i18n/utils';
import type { Locale } from '../data/tools';
interface Props { locale: Locale }
const { locale } = Astro.props;
const clientKeys: TranslationKey[] = [
  'error.comment', 'error.depth', 'error.jsonLines', 'error.location', 'error.singleQuote',
  'error.syntax', 'error.trailingComma', 'error.unquotedKey', 'jsonCsv.columnsCap', 'jsonCsv.copied',
  'jsonCsv.copy', 'jsonCsv.copyTsv', 'jsonCsv.download', 'jsonCsv.downloadTsv',
  'jsonCsv.jsonLinesNote', 'jsonCsv.largeIntegerNote', 'jsonCsv.noData', 'jsonCsv.previewCap',
  'jsonCsv.protectedNote.one', 'jsonCsv.protectedNote.other', 'jsonCsv.selectText',
  'jsonCsv.summary', 'jsonCsv.summaryTsv', 'jsonCsv.textView', 'jsonCsv.tooLarge',
  'jsonCsv.tooManyColumns', 'jsonCsv.tsvText', 'jsonCsv.workerError', 'jsonCsv.working',
  'jsonCsv.wrongType', 'tool.columns.one', 'tool.columns.other', 'tool.empty', 'tool.fileLoaded',
  'tool.inputHintTouch', 'tool.largeFileHint', 'tool.readError', 'tool.reading', 'tool.rows.one',
  'tool.rows.other', 'unit.bytes', 'unit.kb', 'unit.mb'
];
const strings = Object.fromEntries(clientKeys.map(key => [key, t(key, locale)]));
---
<div class="drop" id="json-csv-tool" data-strings={JSON.stringify(strings)} data-locale={locale}>
  <div class="tool-frame">
    <label class="field-label" for="json-input">{t('tool.inputLabel', locale)}</label>
    <textarea id="json-input" class="json-input" rows="12" spellcheck="false" autocapitalize="off" autocomplete="off"></textarea>
    <p id="input-hint" class="input-hint">{t('tool.inputHint', locale)}</p>
    <div class="actions input-actions">
      <input class="visually-hidden" type="file" id="json-file" accept=".json,.jsonl,.ndjson,.txt,application/json" tabindex="-1" />
      <button class="btn alt" type="button" id="choose-file">{t('tool.choose', locale)}</button>
      <button class="text-button" type="button" id="try-example">{t('tool.example', locale)}</button>
    </div>
    <div class="file-line" id="file-line" hidden><span class="file-name" id="file-name"></span><span class="file-size" id="file-size"></span></div>
    <div class="option-row">
      <fieldset><legend>{t('jsonCsv.separator', locale)}</legend><div class="chips" role="group" aria-label={t('jsonCsv.separator', locale)}>
        <button type="button" data-separator="comma" aria-pressed="true">{t('excel.comma', locale)}</button>
        <button type="button" data-separator="semicolon" aria-pressed="false">{t('excel.semicolon', locale)}</button>
        <button type="button" data-separator="tab" aria-pressed="false">{t('excel.tab', locale)}</button>
      </div></fieldset>
      <fieldset><legend>{t('jsonCsv.encoding', locale)}</legend><div class="chips" role="group" aria-label={t('jsonCsv.encoding', locale)}>
        <button type="button" data-bom="false" aria-pressed="true">{t('excel.utf8', locale)}</button>
        <button type="button" data-bom="true" aria-pressed="false">{t('excel.utf8Bom', locale)}</button>
      </div></fieldset>
    </div>
    <label class="csv-safety"><input id="spreadsheet-safe" type="checkbox" checked /> <span>{t('jsonCsv.safeLabel', locale)}</span></label>
    <p class="input-hint csv-safety-hint">{t('jsonCsv.safeHint', locale)}</p>
    <button class="btn" id="convert" type="button">{t('jsonCsv.convert', locale)}</button>
    <p id="status" class="status" role="status" aria-live="polite" aria-atomic="true" hidden></p>
    <div id="preview-placeholder" class="preview-placeholder excel-placeholder"><p>{t('tool.previewPlaceholder', locale)}</p></div>
    <div id="result" class="result excel-result" hidden>
      <div class="result-head"><div class="chips" role="group" aria-label={t('jsonCsv.resultView', locale)}>
        <button type="button" data-view="table" aria-pressed="true">{t('excel.previewTable', locale)}</button>
        <button type="button" data-view="text" aria-pressed="false">{t('jsonCsv.textView', locale)}</button>
      </div><p class="result-summary" id="result-summary" aria-live="polite" aria-atomic="true"></p></div>
      <div class="result-view">
        <div class="sheet-preview" id="csv-preview" tabindex="0" role="region" aria-label={t('jsonCsv.previewLabel', locale)}><table id="preview-table"></table></div>
        <pre class="code-view" id="csv-view" tabindex="0" hidden></pre>
      </div>
      <p class="result-note" id="preview-note"></p>
      <p class="result-note" id="code-note" hidden>{t('jsonCsv.codeCap', locale)}</p>
      <p class="result-note" id="conversion-note" hidden></p>
      <div class="actions"><button class="btn" id="download" type="button">{t('jsonCsv.download', locale)}</button><button class="btn alt" id="copy" type="button">{t('jsonCsv.copy', locale)}</button><button class="btn alt" id="start-over" type="button">{t('tool.startOver', locale)}</button></div>
    </div>
  </div>
</div>
<script src="../scripts/json-to-csv.ts"></script>
