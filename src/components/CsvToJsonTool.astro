---
import { t, type TranslationKey } from '../i18n/utils';
import type { Locale } from '../data/tools';

interface Props { locale?: Locale }
const { locale = 'en' } = Astro.props;

const clientKeys: TranslationKey[] = [
  'csvJson.inputTitle', 'csvJson.stateReady', 'csvJson.outputTitle',
  'csvJson.inputAria', 'csvJson.sourceLabel', 'csvJson.chooseFile',
  'csvJson.tryExample', 'csvJson.clear', 'csvJson.codeAria',
  'csvJson.codePlaceholder', 'csvJson.outputLabel', 'csvJson.copy',
  'csvJson.download', 'csvJson.separator', 'csvJson.autoDetect',
  'csvJson.encoding', 'csvJson.jsonFormat', 'csvJson.formatPretty',
  'csvJson.formatCompact', 'csvJson.formatLines', 'csvJson.firstRowHeaders',
  'csvJson.detectTypes', 'csvJson.emptyAsNull', 'csvJson.checkResult',
  'csvJson.tableAria', 'csvJson.stateWorking', 'csvJson.stateReadyRows',
  'csvJson.copied', 'csvJson.summaryRows', 'csvJson.previewNote',
  'csvJson.diagDifferingWidths', 'csvJson.diagRenamedHeaders',
  'csvJson.errEmpty', 'csvJson.errTooLarge', 'csvJson.errTooManyColumns',
  'csvJson.errRead', 'csvJson.errWorker', 'csvJson.defaultColumn',
  'csvJson.codeTruncated', 'csvJson.downloadJsonl', 'csvJson.summaryMeta',
  'csvJson.errInvalidQuote', 'csvJson.tooLargeEditor', 'csvJson.errDecode',
  'csvJson.errFileType', 'csvJson.reading', 'csvJson.pastedCsv',
  'csvJson.exampleCsv', 'csvJson.errClipboard',
  'csvJson.delimiterComma', 'csvJson.delimiterSemicolon', 'csvJson.delimiterTab', 'csvJson.delimiterPipe',
  'unit.bytes', 'unit.kb', 'unit.mb'
];
const strings = Object.fromEntries(clientKeys.map(key => [key, t(key, locale)]));
---
<div class="drop csv-json-drop" id="csv-json-tool" data-strings={JSON.stringify(strings)} data-locale={locale}>
  <div class="csv-json-workspace">
    <div class="csv-json-topline"><span>{t('csvJson.inputTitle', locale)}</span><span id="csv-json-state">{t('csvJson.stateReady', locale)}</span><span>{t('csvJson.outputTitle', locale)}</span></div>
    <div class="csv-json-panes">
      <div class="csv-json-pane">
        <label class="visually-hidden" for="csv-json-input">{t('csvJson.inputAria', locale)}</label>
        <textarea id="csv-json-input" class="json-input" spellcheck="false" autocapitalize="off" autocomplete="off" placeholder={'name,city,visits\nAda,London,12\n"Grace, Jr.",New York,8'}></textarea>
        <div class="csv-json-pane-foot"><span id="csv-json-source-label">{t('csvJson.sourceLabel', locale)}</span><div class="actions"><input class="visually-hidden" id="csv-json-file" type="file" accept=".csv,.tsv,.tab,.txt,text/csv,text/tab-separated-values" tabindex="-1" /><button class="text-button" id="csv-json-choose" type="button">{t('csvJson.chooseFile', locale)}</button><button class="text-button" id="csv-json-example" type="button">{t('csvJson.tryExample', locale)}</button><button class="text-button" id="csv-json-clear" type="button">{t('csvJson.clear', locale)}</button></div></div>
      </div>
      <div class="csv-json-pane csv-json-output">
        <pre id="csv-json-code" class="code-view" tabindex="0" aria-label={t('csvJson.codeAria', locale)}>{t('csvJson.codePlaceholder', locale)}</pre>
        <div class="csv-json-pane-foot"><span id="csv-json-output-label">{t('csvJson.outputLabel', locale)}</span><div class="actions"><button class="text-button" id="csv-json-copy" type="button" disabled>{t('csvJson.copy', locale)}</button><button class="text-button" id="csv-json-download" type="button" disabled>{t('csvJson.download', locale)}</button></div></div>
      </div>
    </div>
    <p id="csv-json-status" class="csv-json-status" role="status" aria-live="polite" hidden></p>
    <div class="csv-json-settings">
      <label>{t('csvJson.separator', locale)}<select id="csv-json-separator" class="tool-select"><option value="auto">{t('csvJson.autoDetect', locale)}</option><option value="comma">{t('csvJson.delimiterComma', locale)}</option><option value="semicolon">{t('csvJson.delimiterSemicolon', locale)}</option><option value="tab">{t('csvJson.delimiterTab', locale)}</option><option value="pipe">{t('csvJson.delimiterPipe', locale)}</option></select></label>
      <label>{t('csvJson.encoding', locale)}<select id="csv-json-encoding" class="tool-select"><option value="auto">{t('csvJson.autoDetect', locale)}</option><option value="utf-8">UTF-8</option><option value="utf-16le">UTF-16 LE</option><option value="utf-16be">UTF-16 BE</option><option value="windows-1252">Windows-1252</option></select></label>
      <label>{t('csvJson.jsonFormat', locale)}<select id="csv-json-format" class="tool-select"><option value="pretty">{t('csvJson.formatPretty', locale)}</option><option value="compact">{t('csvJson.formatCompact', locale)}</option><option value="lines">{t('csvJson.formatLines', locale)}</option></select></label>
      <div class="csv-json-checks"><label><input id="csv-json-headers" type="checkbox" checked /> {t('csvJson.firstRowHeaders', locale)}</label><label><input id="csv-json-types" type="checkbox" /> {t('csvJson.detectTypes', locale)}</label><label><input id="csv-json-null" type="checkbox" /> {t('csvJson.emptyAsNull', locale)}</label></div>
    </div>
    <div id="csv-json-details" class="csv-json-details" hidden>
      <div class="csv-json-details-head"><h2>{t('csvJson.checkResult', locale)}</h2><p id="csv-json-summary"></p></div>
      <p id="csv-json-diagnostics" class="csv-json-diagnostics"></p>
      <div class="csv-json-table-scroll" tabindex="0" role="region" aria-label={t('csvJson.tableAria', locale)}><table id="csv-json-table"></table></div>
      <p class="result-note" id="csv-json-preview-note"></p>
    </div>
  </div>
</div>
<script src="../scripts/csv-to-json.ts"></script>
<style>
  .csv-json-drop { padding: 0; overflow: hidden; }
  .csv-json-workspace { min-width: 0; }
  .csv-json-topline { display: grid; grid-template-columns: 1fr auto 1fr; gap: 12px; align-items: center; padding: 12px 20px; border-bottom: 1px solid var(--line); font-weight: 600; font-stretch: 85%; }
  .csv-json-topline span:nth-child(2) { color: var(--slate); font-size: 13px; font-weight: 500; }
  .csv-json-panes { display: grid; grid-template-columns: 1fr 1fr; min-height: 380px; }
  .csv-json-pane { display: flex; flex-direction: column; min-width: 0; border-right: 1px solid var(--line); }
  .csv-json-output { border-right: 0; background: var(--paper); }
  .csv-json-pane textarea, .csv-json-pane pre { flex: 1; margin: 0; border: 0; border-radius: 0; min-height: 320px; box-shadow: none; font-size: 13px; line-height: 1.45; }
  .csv-json-pane-foot { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 10px 16px; border-top: 1px solid var(--line); font-size: 12px; color: var(--slate); background: #fafbfc; }
  .csv-json-pane-foot .actions { gap: 12px; }
  .csv-json-settings { display: grid; grid-template-columns: 1fr 1fr 1fr auto; gap: 16px; align-items: end; padding: 16px 20px; border-top: 1px solid var(--line); background: #fafbfc; }
  .csv-json-settings label { font-size: 12px; font-weight: 600; color: var(--slate); }
  .csv-json-settings .tool-select { margin-top: 4px; width: 100%; }
  .csv-json-checks { display: flex; gap: 16px; align-items: center; padding-bottom: 8px; }
  .csv-json-checks label { display: flex; align-items: center; gap: 6px; font-weight: 500; color: var(--ink); cursor: pointer; }
  .csv-json-checks input { width: 15px; height: 15px; accent-color: var(--cobalt); }
  .csv-json-details { padding: 20px; border-top: 1px solid var(--line); }
  .csv-json-details-head { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; margin-bottom: 12px; }
  .csv-json-details-head h2 { font-size: 18px; margin: 0; font-stretch: 85%; }
  #csv-json-summary { color: var(--slate); font-size: 13px; margin: 0; }
  .csv-json-diagnostics { font-size: 13px; color: #b42318; background: #fef3f2; border: 1px solid #fecdca; border-radius: 4px; padding: 8px 12px; margin: 0 0 12px; }
  .csv-json-table-scroll { overflow: auto; max-height: 260px; border: 1px solid var(--line); border-radius: 4px; }
  #csv-json-table { width: 100%; border-collapse: collapse; font-size: 13px; font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; }
  :global(#csv-json-table th), :global(#csv-json-table td) { padding: 6px 10px; border: 1px solid var(--line); text-align: start; white-space: nowrap; max-width: 220px; overflow: hidden; text-overflow: ellipsis; }
  :global(#csv-json-table th) { background: #f0f2f6; position: sticky; top: 0; z-index: 1; font-family: system-ui, sans-serif; font-size: 12px; }
  .result-note { color: var(--slate); font-size: 12px; margin: 8px 0 0; }
  .csv-json-status { margin: 0; padding: 8px 20px; font-size: 13px; background: #fff5eb; color: #b54708; border-top: 1px solid var(--line); }
  @media (max-width: 860px) {
    .csv-json-panes { grid-template-columns: 1fr; }
    .csv-json-pane { border-right: 0; border-bottom: 1px solid var(--line); }
    .csv-json-settings { grid-template-columns: 1fr 1fr; }
    .csv-json-checks { grid-column: 1 / -1; flex-wrap: wrap; }
  }
</style>
