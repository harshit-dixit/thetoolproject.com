---
import { t, type TranslationKey } from '../i18n/utils';
import type { Locale } from '../data/tools';

interface Props { locale?: Locale }
const { locale = 'en' } = Astro.props;

const clientKeys: TranslationKey[] = [
  'csvViewer.allColumns', 'csvViewer.cellAria', 'csvViewer.cellEmpty', 'csvViewer.confirmDiscard',
  'csvViewer.editCellAria', 'csvViewer.emptyCell', 'csvViewer.errClipboard', 'csvViewer.errEmpty',
  'csvViewer.errLargeMemory', 'csvViewer.errReadGeneric', 'csvViewer.errReadRow',
  'csvViewer.errTooManyColumns', 'csvViewer.errWorker', 'csvViewer.metaIrregular.one',
  'csvViewer.metaIrregular.other', 'csvViewer.metaPasted', 'csvViewer.metaSeparated',
  'csvViewer.profileBlanks', 'csvViewer.profileDistinct', 'csvViewer.profileExamples',
  'csvViewer.profileNone', 'csvViewer.profileValues', 'csvViewer.reading', 'csvViewer.sepComma',
  'csvViewer.sepPipe', 'csvViewer.sepSemicolon', 'csvViewer.sepTab', 'csvViewer.showingRows.one',
  'csvViewer.showingRows.other', 'csvViewer.sortHeader', 'csvViewer.statusCopied',
  'csvViewer.statusCsvDownloaded', 'csvViewer.statusJsonDownloaded', 'csvViewer.statusReverted'
];
const strings = Object.fromEntries(clientKeys.map(key => [key, t(key, locale)]));
---
<div class="drop csv-viewer" id="csv-viewer" data-strings={JSON.stringify(strings)} data-locale={locale}>
  <div class="viewer-import" id="viewer-import">
    <h2 class="drop-title">{t('csvViewer.openTitle', locale)}</h2>
    <p class="drop-hint">{t('csvViewer.openHint', locale)}</p>
    <div class="actions">
      <input class="visually-hidden" id="viewer-file" type="file" accept=".csv,.tsv,.tab,.txt,text/csv,text/tab-separated-values" />
      <button class="btn" id="viewer-choose" type="button">{t('csvViewer.chooseFile', locale)}</button>
      <button class="btn alt" id="viewer-paste-toggle" type="button" aria-expanded="false" aria-controls="viewer-paste-panel">{t('csvViewer.pasteToggle', locale)}</button>
      <button class="text-button" id="viewer-example" type="button">{t('csvViewer.tryExample', locale)}</button>
    </div>
    <div id="viewer-paste-panel" class="viewer-paste" hidden>
      <label class="field-label" for="viewer-paste">{t('csvViewer.pasteLabel', locale)}</label>
      <textarea id="viewer-paste" class="json-input" rows="7" spellcheck="false" autocapitalize="off" placeholder={'name,city,orders\nAda,London,12\nGrace,New York,8'}></textarea>
      <button class="btn" id="viewer-open-paste" type="button">{t('csvViewer.viewPasted', locale)}</button>
    </div>
    <details class="viewer-options"><summary>{t('csvViewer.importSettings', locale)}</summary><div class="viewer-option-grid">
      <label><span class="field-label">{t('csvViewer.separator', locale)}</span><select id="viewer-separator" class="tool-select"><option value="auto">{t('csvViewer.sepAuto', locale)}</option><option value="comma">{t('csvViewer.sepComma', locale)}</option><option value="semicolon">{t('csvViewer.sepSemicolon', locale)}</option><option value="tab">{t('csvViewer.sepTab', locale)}</option><option value="pipe">{t('csvViewer.sepPipe', locale)}</option></select></label>
      <label><span class="field-label">{t('csvViewer.encoding', locale)}</span><select id="viewer-encoding" class="tool-select"><option value="auto">{t('csvViewer.sepAuto', locale)}</option><option value="utf-8">UTF-8</option><option value="utf-16le">UTF-16 LE</option><option value="utf-16be">UTF-16 BE</option><option value="windows-1252">Windows-1252</option></select></label>
      <label class="viewer-checkbox"><input id="viewer-headers" type="checkbox" checked /> {t('csvViewer.headersCheck', locale)}</label>
    </div></details>
    <p id="viewer-import-status" class="status" role="status" aria-live="polite" hidden></p>
  </div>

  <div class="viewer-workspace" id="viewer-workspace" hidden>
    <div class="viewer-file-head"><div><h2 id="viewer-filename" class="panel-title"></h2><p id="viewer-filemeta" class="viewer-muted"></p></div><div class="actions"><button class="btn alt" id="viewer-replace" type="button">{t('csvViewer.replaceFile', locale)}</button></div></div>
    <div class="viewer-stats" aria-label={t('csvViewer.tableOverview', locale)}><div><strong id="viewer-row-count">0</strong><span>{t('csvViewer.rows', locale)}</span></div><div><strong id="viewer-column-count">0</strong><span>{t('csvViewer.columns', locale)}</span></div><div><strong id="viewer-edit-count">0</strong><span>{t('csvViewer.editedCells', locale)}</span></div></div>
    <div class="viewer-toolbar">
      <label class="viewer-search-label"><span class="field-label">{t('csvViewer.searchAll', locale)}</span><input id="viewer-search" class="tool-select" type="search" placeholder={t('csvViewer.searchPlaceholder', locale)} autocomplete="off" /></label>
      <label><span class="field-label">{t('csvViewer.filterColumn', locale)}</span><select id="viewer-filter-column" class="tool-select"><option value="">{t('csvViewer.allColumns', locale)}</option></select></label>
      <label class="viewer-filter-label"><span class="field-label">{t('csvViewer.contains', locale)}</span><input id="viewer-filter" class="tool-select" type="search" placeholder={t('csvViewer.filterPlaceholder', locale)} autocomplete="off" /></label>
    </div>
    <label id="viewer-irregular-wrap" class="viewer-irregular" hidden><input id="viewer-irregular" type="checkbox" /> {t('csvViewer.showIrregular', locale)}</label>
    <div class="viewer-grid-head"><p id="viewer-showing" aria-live="polite"></p><p>{t('csvViewer.gridTip', locale)}</p></div>
    <div class="viewer-table-scroll" id="viewer-scroll" role="region" aria-label={t('csvViewer.tableAria', locale)} tabindex="0"><table id="viewer-table"><thead id="viewer-thead"></thead><tbody id="viewer-tbody"></tbody></table></div>
    <p id="viewer-empty" class="viewer-empty" hidden>{t('csvViewer.emptyFiltered', locale)}</p>
    <div class="viewer-inspector"><div><h3>{t('csvViewer.columnDetails', locale)}</h3><label class="field-label" for="viewer-inspect-column">{t('csvViewer.chooseColumn', locale)}</label><select id="viewer-inspect-column" class="tool-select"></select></div><dl id="viewer-profile"></dl></div>
    <div class="viewer-export"><div><h3>{t('csvViewer.exportData', locale)}</h3><p class="viewer-muted">{t('csvViewer.exportDesc', locale)}</p></div><div class="viewer-export-actions"><label><span class="field-label">{t('csvViewer.rowsToExport', locale)}</span><select id="viewer-export-scope" class="tool-select"><option value="all">{t('csvViewer.allRows', locale)}</option><option value="visible">{t('csvViewer.shownRows', locale)}</option></select></label><div class="actions"><button class="btn" id="viewer-download-csv" type="button">{t('csvViewer.downloadCsv', locale)}</button><button class="btn alt" id="viewer-download-json" type="button">{t('csvViewer.downloadJson', locale)}</button><button class="btn alt" id="viewer-copy" type="button">{t('csvViewer.copyTsv', locale)}</button><button class="text-button" id="viewer-revert" type="button" disabled>{t('csvViewer.revertEdits', locale)}</button></div></div></div>
    <p id="viewer-status" class="status" role="status" aria-live="polite" hidden></p>
  </div>
</div>
<script src="../scripts/csv-viewer.ts"></script>
<style>
  .csv-viewer { min-height: 420px; }
  .viewer-import { display: grid; justify-items: start; }
  .viewer-import .drop-hint { text-align: start; margin-block: 12px 24px; }
  .viewer-paste { width: 100%; margin-block-start: 28px; }
  .viewer-paste .btn { margin-block-start: 12px; }
  .viewer-options { width: 100%; border-block-start: 1px solid var(--line); margin-block-start: 28px; padding-block-start: 16px; }
  .viewer-options summary { cursor: pointer; font-weight: 600; }
  .viewer-option-grid { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 20px; align-items: end; margin-block-start: 20px; }
  .viewer-option-grid label, .viewer-toolbar label { min-width: 0; }
  .viewer-option-grid .tool-select, .viewer-toolbar .tool-select, .viewer-inspector .tool-select, .viewer-export .tool-select { width: 100%; }
  .viewer-checkbox { display: flex; gap: 10px; align-items: center; padding-block-end: 10px; }
  .viewer-checkbox input { width: 18px; height: 18px; accent-color: var(--cobalt); }
  .viewer-workspace { min-width: 0; }
  .viewer-file-head, .viewer-grid-head, .viewer-export { display: flex; justify-content: space-between; gap: 16px 24px; align-items: start; flex-wrap: wrap; }
  .viewer-file-head .panel-title { margin-block: 0 4px; overflow-wrap: anywhere; }
  .viewer-muted, .viewer-grid-head p { color: var(--slate); font-size: 14px; margin: 0; }
  .viewer-stats { display: grid; grid-template-columns: repeat(3,1fr); border-block: 1px solid var(--line); margin-block: 24px; }
  .viewer-stats div { display: flex; flex-direction: column; padding: 16px 20px; border-inline-end: 1px solid var(--line); }
  .viewer-stats div:first-child { padding-inline-start: 0; }
  .viewer-stats div:last-child { border: 0; }
  .viewer-stats strong { font-size: 28px; font-weight: 700; font-stretch: 75%; font-variant-numeric: tabular-nums; line-height: 1; }
  .viewer-stats span { font-size: 14px; color: var(--slate); margin-block-start: 4px; }
  .viewer-toolbar { display: grid; grid-template-columns: 1.4fr 1fr 1fr; gap: 12px; margin-block-end: 16px; }
  .viewer-irregular { display: flex; align-items: center; gap: 8px; font-size: 14px; margin-block: 0 16px; }
  .viewer-irregular input { width: 17px; height: 17px; accent-color: var(--cobalt); }
  .viewer-grid-head { align-items: baseline; margin-block-end: 8px; }
  .viewer-grid-head p:first-child { color: var(--ink); font-weight: 600; font-variant-numeric: tabular-nums; }
  .viewer-table-scroll { height: 440px; overflow: auto; border: 1.5px solid var(--line); border-radius: 4px; max-width: 100%; }
  #viewer-table { border-collapse: separate; border-spacing: 0; table-layout: fixed; width: max-content; min-width: 100%; font-size: 14px; line-height: 1.3; }
  :global(#viewer-table th), :global(#viewer-table td) { width: 190px; min-width: 190px; max-width: 190px; height: 38px; padding: 0; border-inline-end: 1px solid var(--line); border-block-end: 1px solid var(--line); text-align: start; overflow: hidden; }
  :global(#viewer-table th:first-child), :global(#viewer-table td:first-child) { width: 62px; min-width: 62px; max-width: 62px; position: sticky; inset-inline-start: 0; z-index: 1; background: var(--paper); text-align: end; padding-inline: 8px; color: var(--slate); font-variant-numeric: tabular-nums; }
  :global(#viewer-table th) { position: sticky; inset-block-start: 0; z-index: 2; background: var(--fog); }
  :global(#viewer-table th:first-child) { z-index: 3; background: var(--fog); }
  :global(#viewer-table th button), :global(#viewer-table td button) { display: block; width: 100%; height: 37px; padding: 7px 10px; border: 0; background: transparent; color: inherit; text-align: start; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; cursor: pointer; font: inherit; }
  :global(#viewer-table th button) { font-weight: 600; }
  :global(#viewer-table th button:hover), :global(#viewer-table td button:hover) { background: var(--cobalt-wash); }
  :global(#viewer-table td input) { width: 100%; height: 37px; border: 2px solid var(--cobalt); border-radius: 0; padding-inline: 8px; font: inherit; }
  :global(#viewer-table tr[data-edited] td[data-edited]) { background: var(--cobalt-wash); }
  :global(#viewer-table .viewer-spacer td) { height: 0; border: 0; padding: 0; }
  .viewer-empty { padding: 20px; margin: 0; border: 1px solid var(--line); border-block-start: 0; }
  .viewer-inspector, .viewer-export { border-block-start: 1px solid var(--line); margin-block-start: 24px; padding-block-start: 24px; }
  .viewer-inspector { display: grid; grid-template-columns: 220px 1fr; gap: 24px; }
  .viewer-inspector h3, .viewer-export h3 { margin: 0 0 12px; font-size: 22px; font-stretch: 88%; }
  .viewer-inspector dl { display: grid; grid-template-columns: repeat(4,1fr); gap: 8px 20px; margin: 0; }
  :global(#viewer-profile div) { min-width: 0; }
  :global(#viewer-profile dt) { color: var(--slate); font-size: 14px; }
  :global(#viewer-profile dd) { margin: 2px 0 0; font-weight: 600; overflow-wrap: anywhere; font-variant-numeric: tabular-nums; }
  .viewer-export > div:first-child { max-width: 48ch; }
  .viewer-export-actions { display: grid; justify-items: end; gap: 14px; }
  .viewer-export-actions label { min-width: 180px; }
  .viewer-export-actions .actions { justify-content: end; }
  .viewer-export-actions .text-button:disabled { color: var(--slate); cursor: default; }
  @media(max-width: 760px) { .viewer-option-grid, .viewer-toolbar { grid-template-columns: 1fr 1fr; } .viewer-search-label { grid-column: 1 / -1; } .viewer-inspector { grid-template-columns: 1fr; } .viewer-export-actions { justify-items: start; } .viewer-export-actions .actions { justify-content: start; } }
  @media(max-width: 560px) { .viewer-option-grid { grid-template-columns: 1fr; } .viewer-stats strong { font-size: 22px; } .viewer-stats div { padding-inline: 10px; } .viewer-toolbar { grid-template-columns: 1fr; } .viewer-search-label { grid-column: auto; } .viewer-inspector dl { grid-template-columns: 1fr 1fr; } .viewer-grid-head p:last-child { display: none; } }
</style>
