---
import { t, type TranslationKey } from '../i18n/utils';
import type { Locale } from '../data/tools';

interface Props { locale?: Locale }
const { locale = 'en' } = Astro.props;

const clientKeys: TranslationKey[] = [
  'qr.cameraHidden', 'qr.cameraStopped', 'qr.clipboardSelected', 'qr.copied', 'qr.copyResult',
  'qr.destination', 'qr.errImageRead', 'qr.errImageTooLarge', 'qr.errImageType', 'qr.errNotFound',
  'qr.errNotFoundInImage', 'qr.errPermissionDenied', 'qr.errReaderStopped', 'qr.errSecureContext',
  'qr.errStartFailed', 'qr.errTorch', 'qr.looking', 'qr.noteDefault', 'qr.noteUnencrypted',
  'qr.pastedImage', 'qr.readingImage', 'qr.startingReader', 'qr.torchOff', 'qr.torchOn',
  'qr.typeContact', 'qr.typeLink', 'qr.typeText', 'qr.typeWifi', 'qr.waitingPermission'
];
const strings = Object.fromEntries(clientKeys.map(key => [key, t(key, locale)]));
---
<div class="qr-tool" id="qr-tool" data-strings={JSON.stringify(strings)} data-locale={locale}>
  <div class="qr-topline"><div><h2>{t('qr.heading', locale)}</h2><p>{t('qr.subheading', locale)}</p></div><span class="qr-private">{t('qr.private', locale)}</span></div>
  <div class="qr-modes" role="group" aria-label={t('qr.modesAria', locale)}>
    <button type="button" id="qr-camera-tab" aria-pressed="true">{t('qr.cameraTab', locale)}</button>
    <button type="button" id="qr-image-tab" aria-pressed="false">{t('qr.imageTab', locale)}</button>
  </div>
  <div class="qr-body">
    <div id="qr-camera-panel" class="qr-camera-panel">
      <div class="qr-view" id="qr-view">
        <video id="qr-video" autoplay muted playsinline aria-label={t('qr.videoAria', locale)}></video>
        <div class="qr-view-message" id="qr-view-message"><svg viewBox="0 0 48 48" fill="none" aria-hidden="true"><path d="M4 16V8a4 4 0 0 1 4-4h8M32 4h8a4 4 0 0 1 4 4v8M44 32v8a4 4 0 0 1-4 4h-8M16 44H8a4 4 0 0 1-4-4v-8M14 14h8v8h-8zM26 14h8v8h-8zM14 26h8v8h-8zM26 26h3M34 26v8h-8" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round"/></svg><p>{t('qr.cameraPreviewPlaceholder', locale)}</p></div>
      </div>
      <div class="qr-controls"><button type="button" class="btn" id="qr-start">{t('qr.startCamera', locale)}</button><button type="button" class="btn alt" id="qr-stop" hidden>{t('qr.stopCamera', locale)}</button><button type="button" class="text-button" id="qr-switch" hidden>{t('qr.switchCamera', locale)}</button><button type="button" class="text-button" id="qr-torch" hidden aria-pressed="false">{t('qr.torchOn', locale)}</button></div>
      <p class="qr-tip">{t('qr.cameraTip', locale)}</p>
    </div>
    <div id="qr-image-panel" class="qr-image-panel" hidden>
      <div class="qr-file-zone" id="qr-file-zone"><svg viewBox="0 0 48 48" fill="none" aria-hidden="true"><path d="M8 34V10a4 4 0 0 1 4-4h24a4 4 0 0 1 4 4v24M8 34l9-10 7 7 7-9 9 12M8 34v4a4 4 0 0 0 4 4h24a4 4 0 0 0 4-4v-4H8zM18 18h.01" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg><h3>{t('qr.dropTitle', locale)}</h3><p>{t('qr.dropHint', locale)}</p><input type="file" id="qr-file" class="visually-hidden" accept="image/png,image/jpeg,image/webp,image/gif,image/bmp,.png,.jpg,.jpeg,.webp,.gif,.bmp" tabindex="-1" /><button type="button" class="btn" id="qr-choose">{t('qr.chooseImage', locale)}</button></div>
      <p class="qr-tip">{t('qr.imageTip', locale)}</p>
    </div>
    <p id="qr-status" class="qr-status" role="status" aria-live="polite" aria-atomic="true" hidden></p>
    <div class="qr-result" id="qr-result" hidden>
      <div class="qr-result-head"><div><span>{t('qr.foundBadge', locale)}</span><h3 id="qr-result-type">{t('qr.typeText', locale)}</h3></div><button type="button" class="text-button" id="qr-clear">{t('qr.scanAnother', locale)}</button></div>
      <p id="qr-destination" class="qr-destination" hidden></p>
      <label for="qr-output" class="field-label">{t('qr.fullResult', locale)}</label><textarea id="qr-output" readonly spellcheck="false" rows="4"></textarea>
      <div class="qr-result-actions"><button type="button" class="btn" id="qr-copy">{t('qr.copyResult', locale)}</button><a id="qr-open" class="btn alt" target="_blank" rel="noopener noreferrer" hidden>{t('qr.openLink', locale)}</a></div>
      <p class="qr-result-note" id="qr-result-note">{t('qr.noteDefault', locale)}</p>
    </div>
  </div>
</div>
<style>
  .qr-tool { margin-block-start: 40px; border: 2px solid var(--ink); border-radius: 4px; background: var(--paper); overflow: hidden; }
  .qr-topline { display: flex; justify-content: space-between; align-items: end; gap: 20px; padding: 28px 32px 24px; }
  .qr-topline h2 { font-size: 32px; font-stretch: 88%; line-height: 1; margin: 0 0 8px; }
  .qr-topline p { margin: 0; color: var(--slate); }
  .qr-private { color: var(--cobalt); font-size: 14px; font-weight: 600; white-space: nowrap; }
  .qr-modes { display: flex; border-block: 1px solid var(--line); }
  .qr-modes button { flex: 1; min-height: 52px; border: 0; background: #f7f8fa; color: var(--slate); font: inherit; font-weight: 600; cursor: pointer; }
  .qr-modes button + button { border-inline-start: 1px solid var(--line); }
  .qr-modes button[aria-pressed="true"] { color: var(--ink); background: var(--paper); box-shadow: inset 0 -3px var(--cobalt); }
  .qr-body { padding: 28px 32px 32px; }
  .qr-view { position: relative; display: grid; place-items: center; aspect-ratio: 16 / 8; min-height: 280px; max-height: 520px; background: #151a26; color: white; overflow: hidden; border-radius: 3px; }
  .qr-view video { display: none; width: 100%; height: 100%; position: absolute; inset: 0; object-fit: contain; }
  .qr-view.active video { display: block; }
  .qr-view-message { display: grid; justify-items: center; text-align: center; gap: 8px; color: #dce2f1; }
  .qr-view-message svg { width: 64px; height: 64px; color: #8d9fcd; }
  .qr-view-message p { margin: 0; }
  .qr-view.active .qr-view-message { display: none; }
  .qr-controls, .qr-result-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; margin-block-start: 20px; }
  .qr-tip { margin: 14px 0 0; color: var(--slate); font-size: 14px; }
  .qr-file-zone { min-height: 280px; display: grid; place-content: center; justify-items: center; text-align: center; padding: 28px; border: 2px dashed #a8b0bf; border-radius: 3px; background: #f8f9fb; }
  .qr-file-zone.over { border-color: var(--cobalt); background: var(--cobalt-wash); }
  .qr-file-zone svg { width: 54px; height: 54px; color: var(--cobalt); margin-block-end: 12px; }
  .qr-file-zone h3 { margin: 0; font-size: 25px; line-height: 1.2; font-stretch: 88%; }
  .qr-file-zone p { margin: 6px 0 20px; color: var(--slate); }
  .qr-status { margin: 20px 0 0; padding: 12px 16px; background: var(--cobalt-wash); color: var(--ink); border-inline-start: 3px solid var(--cobalt); }
  .qr-status.error { background: #fff0ef; border-color: #b33e31; }
  .qr-result { border-block-start: 1px solid var(--line); margin-block-start: 28px; padding-block-start: 24px; }
  .qr-result-head { display: flex; justify-content: space-between; align-items: start; gap: 16px; }
  .qr-result-head span { color: #2e714d; font-size: 14px; font-weight: 700; }
  .qr-result-head h3 { margin: 4px 0 20px; font-size: 28px; line-height: 1.2; font-stretch: 88%; }
  .qr-destination { margin: 0 0 16px; font-weight: 600; color: var(--ink); word-break: break-all; }
  .field-label { display: block; margin: 0 0 8px; font-weight: 600; font-size: 14px; color: var(--slate); }
  textarea#qr-output { width: 100%; box-sizing: border-box; padding: 12px 14px; border: 1.5px solid var(--ink); border-radius: 3px; background: var(--paper); font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; font-size: 14px; line-height: 1.5; resize: vertical; }
  .qr-result-note { margin: 12px 0 0; color: var(--slate); font-size: 14px; }
  .text-button { border: 0; background: none; color: var(--cobalt); font: inherit; font-weight: 600; text-decoration: underline; cursor: pointer; padding: 0; }
  @media (max-width: 640px) {
    .qr-topline { display: grid; grid-template-columns: 1fr; padding: 22px 20px 18px; }
    .qr-body { padding: 20px; }
  }
</style>
<script src="../scripts/qr-code-scanner.ts"></script>
