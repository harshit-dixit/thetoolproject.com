<div class="drop" id="xml-json-tool">
  <div class="tool-frame">
    <label class="field-label" for="xml-json-input">Input XML</label>
    <textarea id="xml-json-input" class="json-input" rows="12" spellcheck="false" autocapitalize="off" autocomplete="off" placeholder="Paste XML here, or choose a file"></textarea>
    <p class="input-hint">Paste XML, drop a file here, or choose a .xml or .txt file. Files stay in your browser.</p>
    <div class="actions input-actions">
      <input class="visually-hidden" type="file" id="xml-json-file" accept=".xml,.txt,text/xml,application/xml" tabindex="-1" />
      <button class="btn alt" type="button" id="xml-json-choose">Choose XML file</button>
      <button class="text-button" type="button" id="xml-json-example">Try an example</button>
    </div>
    <div class="file-line" id="xml-json-file-line" hidden><span class="file-name" id="xml-json-file-name"></span><span class="file-size" id="xml-json-file-size"></span></div>
    <div class="option-row xml-json-options">
      <fieldset><legend>Attributes</legend><div class="chips" role="group" aria-label="Attribute prefix">
        <button type="button" data-xml-json-prefix="@_" aria-pressed="true">@_id</button>
        <button type="button" data-xml-json-prefix="@" aria-pressed="false">@id</button>
      </div></fieldset>
      <fieldset><legend>Repeated elements</legend><label class="xml-json-check"><input id="xml-json-arrays" type="checkbox" /> Always use arrays</label></fieldset>
      <fieldset><legend>Output</legend><label class="xml-json-check"><input id="xml-json-pretty" type="checkbox" checked /> Pretty print</label></fieldset>
    </div>
    <button class="btn" id="xml-json-convert" type="button">Convert XML to JSON</button>
    <p id="xml-json-status" class="status" role="status" aria-live="polite" aria-atomic="true" hidden></p>
    <div id="xml-json-placeholder" class="preview-placeholder"><p>Your JSON will appear here after conversion.</p></div>
    <div id="xml-json-result" class="result" hidden>
      <div class="result-head"><label class="field-label" for="xml-json-output">JSON output</label><p class="result-summary" id="xml-json-summary"></p></div>
      <textarea id="xml-json-output" class="code-view xml-json-output" readonly spellcheck="false" aria-label="JSON output"></textarea>
      <div class="actions"><button class="btn" id="xml-json-download" type="button">Download JSON</button><button class="btn alt" id="xml-json-copy" type="button">Copy JSON</button><button class="btn alt" id="xml-json-start-over" type="button">Start over</button></div>
    </div>
  </div>
</div>
<style>
  .xml-json-options { align-items: end; }
  .xml-json-check { display: inline-flex; align-items: center; gap: 9px; min-height: 40px; cursor: pointer; font-weight: 600; }
  .xml-json-check input { width: 18px; height: 18px; accent-color: var(--cobalt); }
  .xml-json-output { width: 100%; height: 360px; resize: vertical; background: var(--paper); color: var(--ink); }
  @media (max-width: 560px) { .xml-json-output { height: 300px; } }
</style>
<script src="../scripts/xml-to-json.ts"></script>
