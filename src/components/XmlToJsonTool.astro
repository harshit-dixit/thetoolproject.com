---
import { t, type TranslationKey } from '../i18n/utils';
import type { Locale } from '../data/tools';

interface Props { locale?: Locale }
const { locale = 'en' } = Astro.props;

const clientKeys: TranslationKey[] = [
  'xmlJson.copy', 'xmlJson.copied', 'xmlJson.copiedAria',
  'xmlJson.working', 'xmlJson.reading', 'xmlJson.summary',
  'xmlJson.elements.one', 'xmlJson.elements.other',
  'xmlJson.errDoctype', 'xmlJson.errTooDeep', 'xmlJson.errEmpty',
  'xmlJson.errSyntax', 'xmlJson.syntaxCheck', 'xmlJson.errWorker',
  'xmlJson.errTooLarge', 'xmlJson.errWrongType', 'xmlJson.fileTooLargeText',
  'xmlJson.fileLoaded', 'xmlJson.errRead', 'xmlJson.errClipboard',
  'unit.bytes', 'unit.kb', 'unit.mb'
];
const strings = Object.fromEntries(clientKeys.map(key => [key, t(key, locale)]));
---
<div class="drop" id="xml-json-tool" data-strings={JSON.stringify(strings)} data-locale={locale}>
  <div class="tool-frame">
    <label class="field-label" for="xml-json-input">{t('xmlJson.inputLabel', locale)}</label>
    <textarea id="xml-json-input" class="json-input" rows="12" spellcheck="false" autocapitalize="off" autocomplete="off" placeholder={t('xmlJson.inputPlaceholder', locale)}></textarea>
    <p class="input-hint">{t('xmlJson.inputHint', locale)}</p>
    <div class="actions input-actions">
      <input class="visually-hidden" type="file" id="xml-json-file" accept=".xml,.txt,text/xml,application/xml" tabindex="-1" />
      <button class="btn alt" type="button" id="xml-json-choose">{t('xmlJson.chooseFile', locale)}</button>
      <button class="text-button" type="button" id="xml-json-example">{t('xmlJson.tryExample', locale)}</button>
    </div>
    <div class="file-line" id="xml-json-file-line" hidden><span class="file-name" id="xml-json-file-name"></span><span class="file-size" id="xml-json-file-size"></span></div>
    <div class="option-row xml-json-options">
      <fieldset><legend>{t('xmlJson.attributes', locale)}</legend><div class="chips" role="group" aria-label={t('xmlJson.prefixAria', locale)}>
        <button type="button" data-xml-json-prefix="@_" aria-pressed="true">@_id</button>
        <button type="button" data-xml-json-prefix="@" aria-pressed="false">@id</button>
      </div></fieldset>
      <fieldset><legend>{t('xmlJson.repeated', locale)}</legend><label class="xml-json-check"><input id="xml-json-arrays" type="checkbox" /> {t('xmlJson.alwaysArray', locale)}</label></fieldset>
      <fieldset><legend>{t('xmlJson.output', locale)}</legend><label class="xml-json-check"><input id="xml-json-pretty" type="checkbox" checked /> {t('xmlJson.pretty', locale)}</label></fieldset>
    </div>
    <button class="btn" id="xml-json-convert" type="button">{t('xmlJson.convertButton', locale)}</button>
    <p id="xml-json-status" class="status" role="status" aria-live="polite" aria-atomic="true" hidden></p>
    <div id="xml-json-placeholder" class="preview-placeholder"><p>{t('xmlJson.placeholder', locale)}</p></div>
    <div id="xml-json-result" class="result" hidden>
      <div class="result-head"><label class="field-label" for="xml-json-output">{t('xmlJson.outputLabel', locale)}</label><p class="result-summary" id="xml-json-summary"></p></div>
      <textarea id="xml-json-output" class="code-view xml-json-output" readonly spellcheck="false" aria-label={t('xmlJson.outputLabel', locale)}></textarea>
      <div class="actions"><button class="btn" id="xml-json-download" type="button">{t('xmlJson.download', locale)}</button><button class="btn alt" id="xml-json-copy" type="button">{t('xmlJson.copy', locale)}</button><button class="btn alt" id="xml-json-start-over" type="button">{t('xmlJson.startOver', locale)}</button></div>
    </div>
  </div>
</div>
<style>
  .xml-json-options { align-items: end; }
  .xml-json-check { display: inline-flex; align-items: center; gap: 9px; min-height: 40px; cursor: pointer; font-weight: 600; }
  .xml-json-check input { width: 18px; height: 18px; accent-color: var(--cobalt); }
  .xml-json-output { width: 100%; height: 360px; resize: vertical; background: var(--paper); color: var(--ink); }
  @media (max-width: 560px) { .xml-json-output { height: 300px; } }
</style>
<script src="../scripts/xml-to-json.ts"></script>
