---
import { t, type TranslationKey } from '../i18n/utils';
import type { Locale } from '../data/tools';

interface Props { locale?: Locale }
const { locale = 'en' } = Astro.props;

const clientKeys: TranslationKey[] = [
  'dbf.errEncoding', 'dbf.errInvalid', 'dbf.errMemo', 'dbf.errTooLarge', 'dbf.errTooManyColumns',
  'dbf.errTooManyRows', 'dbf.errUnsupported', 'dbf.errWorker', 'dbf.errWrongType',
  'dbf.noteEncoding', 'dbf.notePreviewLimited', 'dbf.noteSkipped.one', 'dbf.noteSkipped.other',
  'dbf.noteTextNumbers.one', 'dbf.noteTextNumbers.other', 'dbf.reading', 'dbf.ready',
  'dbf.records.one', 'dbf.records.other', 'dbf.summary', 'tool.columns.one', 'tool.columns.other',
  'unit.bytes', 'unit.kb', 'unit.mb'
];
const strings = Object.fromEntries(clientKeys.map(key => [key, t(key, locale)]));
---
<div class="drop" id="dbf-tool" data-strings={JSON.stringify(strings)} data-locale={locale}>
  <div class="tool-frame">
    <input class="visually-hidden" type="file" id="dbf-file" accept=".dbf" tabindex="-1" aria-label={t('dbf.fileAria', locale)} />
    <div class="drop-empty" id="dbf-empty">
      <h2 class="drop-title">{t('dbf.dropTitle', locale)}</h2>
      <p class="drop-hint">{t('dbf.dropHint', locale)}</p>
      <button class="btn" type="button" id="dbf-choose">{t('dbf.chooseButton', locale)}</button>
    </div>
    <div id="dbf-panel" hidden>
      <div class="file-line"><span class="file-name" id="dbf-name"></span><span class="file-size" id="dbf-size"></span></div>
      <div class="option-row">
        <div><label class="field-label" for="dbf-encoding">{t('dbf.encodingLabel', locale)}</label>
          <select id="dbf-encoding" class="dbf-select">
            <option value="auto">{t('dbf.encodingAuto', locale)}</option>
            <option value="windows-1252">{t('dbf.encWestern', locale)} (Windows-1252)</option>
            <option value="windows-1251">{t('dbf.encCyrillic', locale)} (Windows-1251)</option>
            <option value="ibm866">{t('dbf.encCyrillicDos', locale)} (CP866)</option>
            <option value="ibm850">{t('dbf.encWesternDos', locale)} (CP850)</option>
            <option value="ibm437">{t('dbf.encUsDos', locale)} (CP437)</option>
            <option value="utf-8">UTF-8</option>
          </select>
          <p class="input-hint">{t('dbf.encodingHint', locale)}</p>
        </div>
      </div>
      <div class="actions input-actions"><button class="btn" type="button" id="dbf-convert">{t('dbf.convertButton', locale)}</button><button class="btn alt" type="button" id="dbf-change">{t('dbf.changeButton', locale)}</button></div>
      <p id="dbf-status" class="status" role="status" aria-live="polite" aria-atomic="true" hidden></p>
      <div id="dbf-result" class="result excel-result" hidden>
        <p class="result-summary" id="dbf-summary"></p>
        <div class="result-view"><div class="sheet-preview" tabindex="0" role="region" aria-label={t('dbf.previewAria', locale)}><table id="dbf-preview"></table></div></div>
        <p class="result-note" id="dbf-note"></p>
        <div class="actions"><button class="btn" type="button" id="dbf-download">{t('dbf.download', locale)}</button></div>
      </div>
    </div>
  </div>
</div>
<style>
  .dbf-select { display: block; width: min(100%, 380px); min-height: 44px; padding: 8px 10px; border: 1.5px solid var(--line); border-radius: 4px; background: var(--paper); color: var(--ink); font: inherit; }
  #dbf-panel .option-row { margin-block-start: 22px; }
  #dbf-result { margin-block-start: 26px; }
</style>
<script src="../scripts/dbf-to-excel.ts"></script>
