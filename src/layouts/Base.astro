---
import '../styles/global.css';
import { t, langTag } from '../i18n/utils';
import { locales, type Locale } from '../data/tools';
import { getPublishedHomePath, getPublishedPagePath } from '../data/pages';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  path: string;
  alternates?: Partial<Record<Locale, string>>;
  noindex?: boolean;
  // Analytics content group and, on tool pages, the tool id sent with every event.
  pageType?: 'home' | 'tool' | 'guide' | 'page' | 'not_found';
  toolId?: string;
}

const { locale, title, description, path, alternates = { en: path }, noindex = false, pageType = 'page', toolId } = Astro.props;
const canonical = new URL(path, 'https://thetoolproject.com').href;
const alternateEntries = Object.entries(alternates);

const languageNames: Record<Locale, string> = {
  en: 'English',
  es: 'Español',
  pt: 'Português',
  de: 'Deutsch',
  fr: 'Français',
  ja: '日本語',
};

// Same page in each published language, else that language's published home page.
const switcherOptions: { locale: Locale; url: string; label: string }[] = [];
for (const loc of locales) {
  const targetPath = loc === locale ? path : alternates[loc] ?? getPublishedHomePath(loc);
  if (targetPath) switcherOptions.push({ locale: loc, url: targetPath, label: languageNames[loc] });
}

const homeUrl = getPublishedHomePath(locale) ?? '/';
const aboutUrl = getPublishedPagePath('about', locale);
const contactUrl = getPublishedPagePath('contact', locale);
const privacyUrl = getPublishedPagePath('privacy', locale);
const termsUrl = getPublishedPagePath('terms', locale);
---
<!doctype html>
<html lang={langTag(locale)} data-locale={locale} data-page-type={pageType} data-tool={toolId}>
  <head>
    <meta charset="utf-8" />
    <!-- Google tag (gtag.js). Loads only on the live site, or anywhere with ?ga_debug=1 to test in GA DebugView. -->
    <script is:inline>
      (function () {
        var id = 'G-065HLW5DZ3';
        var page = document.documentElement.dataset;
        var debug = /[?&]ga_debug=1(&|$)/.test(location.search);
        var host = location.hostname;
        window.dataLayer = window.dataLayer || [];
        var gtag = window.gtag = function () { window.dataLayer.push(arguments); };
        if (!debug && host !== 'thetoolproject.com' && host !== 'www.thetoolproject.com') return;
        var tag = document.createElement('script');
        tag.async = true;
        tag.src = 'https://www.googletagmanager.com/gtag/js?id=' + id;
        document.head.appendChild(tag);
        gtag('js', new Date());
        // Config parameters are sent with the page_view and every later event on the page.
        var settings = { content_group: page.pageType, page_locale: page.locale };
        if (page.tool) settings.tool_id = page.tool;
        if (debug) settings.debug_mode = true;
        gtag('config', id, settings);
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && <>
      <link rel="canonical" href={canonical} />
      {alternateEntries.map(([lang, alternate]) => <link rel="alternate" hreflang={langTag(lang as Locale)} href={new URL(alternate!, 'https://thetoolproject.com').href} />)}
      {alternates.en && <link rel="alternate" hreflang="x-default" href={new URL(alternates.en, 'https://thetoolproject.com').href} />}
    </>}
    <link rel="preload" href="/fonts/archivo-latin-var.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <slot name="head" />
  </head>
  <body>
    <header class="site-header"><div class="wrap"><a class="logo" href={homeUrl} aria-label={t('brand', locale)}>thetool<b>project</b></a></div></header>
    <slot />
    <footer>
      <div class="wrap footer-inner">
        <span>{t('footer.tagline', locale)}</span>
        <div class="footer-actions">
          {switcherOptions.length > 1 && (
            <form class="language-picker" onsubmit="location.href=this.elements.language.value;return false">
              <label for="language-select" class="visually-hidden">{t('footer.language', locale)}</label>
              <select id="language-select" name="language" class="language-select">
                {switcherOptions.map((opt) => (
                  <option value={opt.url} selected={opt.locale === locale} lang={langTag(opt.locale)} data-locale={opt.locale}>
                    {opt.label}
                  </option>
                ))}
              </select>
              <button type="submit" class="language-go">{t('footer.languageGo', locale)}</button>
            </form>
          )}
          <nav aria-label={t('footer.navLabel', locale)}>
            <a href={aboutUrl}>{t('footer.nav.about', locale)}</a>
            <a href={contactUrl}>{t('footer.nav.contact', locale)}</a>
            <a href={privacyUrl}>{t('footer.nav.privacy', locale)}</a>
            <a href={termsUrl}>{t('footer.nav.terms', locale)}</a>
            <a href="https://github.com/harshit-dixit/thetoolproject.com">{t('footer.nav.github', locale)}</a>
          </nav>
        </div>
      </div>
    </footer>
    <script src="../scripts/analytics.ts"></script>
  </body>
</html>
