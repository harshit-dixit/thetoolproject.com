---
import Base from './Base.astro';
interface Props { title: string; description: string; heading: string; lead: string; path: string }
const { title, description, heading, lead, path } = Astro.props;
---
<Base locale="en" {title} {description} {path}>
  <main class="wrap">
    <div class="hero"><h1 class="page-title">{heading}</h1><p class="lead">{lead}</p></div>
    <div class="text-body"><slot /></div>
  </main>
</Base>
